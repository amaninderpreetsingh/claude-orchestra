#!/usr/bin/env bash
# Create a throwaway repo (with a local bare "origin", so pushes never leave your Mac)
# for an end-to-end test of /orchestrate, then open it in a new cmux workspace running claude.
#   make-demo-repo [--no-launch] [dir]     (default dir: ~/orchestra-demo)
# --no-launch (or ORCH_NO_LAUNCH=1) only creates the repo; tests and verifiers must use it.
# ORCH_CMUX overrides the cmux binary.
set -euo pipefail
LAUNCH=1; DIR=""
for a in "$@"; do
  case "$a" in
    --no-launch) LAUNCH=0 ;;
    -*) echo "make-demo-repo: unknown option $a" >&2; exit 2 ;;
    *) [ -z "$DIR" ] || { echo "make-demo-repo: one dir only" >&2; exit 2; }; DIR="$a" ;;
  esac
done
[ "${ORCH_NO_LAUNCH:-}" != 1 ] || LAUNCH=0
CMUX="${ORCH_CMUX:-cmux}"
DIR="${DIR:-$HOME/orchestra-demo}"
if [ -e "$DIR" ]; then echo "$DIR exists — pass another path or remove it first" >&2; exit 1; fi
mkdir -p "$DIR"; cd "$DIR"
git init -q --bare -b main origin.git
git clone -q origin.git app 2>/dev/null; cd app
cat > package.json <<'EOF'
{ "name": "orchestra-demo", "private": true, "type": "module",
  "scripts": { "test": "node --test", "dev": "node server.js" } }
EOF
cat > server.js <<'EOF'
import { createServer } from 'node:http';
import { readFile } from 'node:fs/promises';
import { extname, resolve, sep } from 'node:path';
import { fileURLToPath } from 'node:url';
const root = fileURLToPath(new URL('.', import.meta.url));
const port = Number(process.env.PORT || 3000);
const utf8 = (t) => `${t}; charset=utf-8`;
// Browsers refuse a module script without a JavaScript Content-Type, so every file gets its type.
const types = { '.html': utf8('text/html'), '.js': utf8('text/javascript'), '.mjs': utf8('text/javascript'),
  '.css': utf8('text/css'), '.json': utf8('application/json'), '.svg': 'image/svg+xml' };
createServer(async (req, res) => {
  try {
    const path = decodeURIComponent(req.url.split('?')[0]);
    const file = resolve(root, '.' + (path === '/' ? '/index.html' : path));
    if (!file.startsWith(root.endsWith(sep) ? root : root + sep)) throw new Error('outside the app dir');
    if (file.slice(root.length).split(sep).some((p) => p.startsWith('.'))) throw new Error('dot path (.git, .env)');
    const body = await readFile(file);
    res.setHeader('Content-Type', types[extname(file).toLowerCase()] || 'application/octet-stream');
    res.end(body);
  } catch { res.statusCode = 404; res.setHeader('Content-Type', utf8('text/plain')); res.end('not found'); }
}).listen(port, '127.0.0.1', () => console.log(`ready on http://127.0.0.1:${port}`));
EOF
cat > index.html <<'EOF'
<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Tip Calculator</title></head>
<body><h1>Tip Calculator</h1><p>Coming soon.</p><script type="module" src="app.js"></script></body></html>
EOF
echo "// app code goes here" > app.js
cat > CLAUDE.md <<'EOF'
# Orchestra demo app
- Plain Node + static HTML, no build step. Gates: `npm test`.
- Dev server: `PORT=<port> npm run dev` (any free port). No backend, nothing deploys — origin is a local bare repo.
- Conventional commits, no trailers.
EOF
printf 'node_modules/\n' > .gitignore
git add . && git commit -qm "chore: demo app skeleton" && git push -q origin main && git remote set-head origin main
echo "Demo repo ready: $DIR/app"
if [ "$LAUNCH" = 1 ] && command -v "$CMUX" >/dev/null; then
  "$CMUX" new-workspace --name "orchestra-demo" --cwd "$DIR/app" --focus true --command "claude" >/dev/null 2>&1 \
    && echo "Opened a cmux workspace 'orchestra-demo' running claude (accept the folder-trust prompt once)."
fi
cat <<EOF

Try (in that chat):
  /orchestrate Build a tip calculator page: bill amount, tip % buttons (15/18/20/custom),
  split between N people, per-person total. Mobile first. Pure JS module for the math.
EOF
