#!/usr/bin/env python3
"""orch — state, locks, evidence and broadcast helper for the /orchestrate workflow.

State lives in ~/.claude/orchestra/. Several coordinators (one per cmux chat) can run at
once on the same or different repos. Anything exclusive (file ownership, pushing to a
branch) is an atomic mkdir lock keyed by repo. Evidence (gate runs, reviewer/verifier
verdicts, gates-ok) lives in the worktree's own git dir, so push-guard can check it.

Run:          new-run, run-branch, baseline, criteria-init, criteria-add, criteria-check, end-run
Workers:      spawn (--dry-run), close, add-worker, finish-worker, broadcast, ports
Files/locks:  lock, unlock, locks, resource-lock, resource-unlock
Health:       doctor (--fix), reap, status, report, dash, note, gc (deletes ended runs' bulk)
Worker:       register, gates, verdict, criterion, gates-ok, merge-lock, merge-unlock, merged
Tier S:       tier (main checkout: gates + lite reviewer PASS, then push)
Env: ORCH_HOME (state dir), ORCH_CMUX (cmux binary, default `cmux`), ORCH_PORT_BASE/ORCH_PORT_SPAN,
     ORCH_CAFFEINATE (the `caffeinate` that keeps the Mac awake during a run; default: `caffeinate`, but only for
     the default ~/.claude/orchestra: any other ORCH_HOME, e.g. a test or probe, holds none unless this is set).
Run `orch <cmd> -h` for flags.
"""
import argparse, contextlib, fcntl, hashlib, json, os, pwd, re, shlex, shutil, socket, subprocess, sys, tempfile, time
from pathlib import Path

HOME = Path(os.environ.get("ORCH_HOME", Path.home() / ".claude" / "orchestra"))
RUNS, LOCKS, EVENTS = HOME / "runs", HOME / "locks", HOME / "events"
CAFF_PID = HOME / "state" / "caffeinate.pid"  # one `caffeinate -is` shared by every active run
CAFF_BIN = HOME / "state" / "caffeinate.bin"  # the name it was started as (ORCH_CAFFEINATE may differ per shell)
PORT_HISTORY = HOME / "state" / "port-history"  # <base>.json: the last owner a block was handed to (outlives release)
MERGE_LOCK_MAX_SECS = 20 * 60          # lock covers only rebase+push, so this is generous
PORT_BLOCK = 10                        # each worker gets its own 10-port block
# tests set ORCH_PORT_BASE/SPAN to a private range so concurrent suites and live workers never share a block
PORT_BASE = int(os.environ.get("ORCH_PORT_BASE", 20000))
PORT_MAX = PORT_BASE + int(os.environ.get("ORCH_PORT_SPAN", 9990))
PASS_ROLES = ("reviewer", "verifier")  # + "adversarial" when the worker is registered --risky
CMUX = os.environ.get("ORCH_CMUX") or "cmux"  # tests point this at a stub; every cmux call goes through it
# The real caffeinate only for the user's own state dir (by the account's home, not $HOME, which tests fake): an
# isolated ORCH_HOME (suite, probe) that started one and was then deleted left it running forever, untraceable.
try:
    DEFAULT_HOME = Path(pwd.getpwuid(os.getuid()).pw_dir) / ".claude" / "orchestra"
except KeyError:  # an account with no passwd entry (some containers): no default home, so only ORCH_CAFFEINATE holds
    DEFAULT_HOME = None
CAFFEINATE = os.environ.get("ORCH_CAFFEINATE") or (
    "caffeinate" if DEFAULT_HOME and os.path.realpath(HOME) == os.path.realpath(DEFAULT_HOME) else None)
LOCK_GRACE_SECS = 60                   # a lock dir with no owner.json is held this long (legacy/crashed taker)
IDLE_RUN_SECS = 12 * 3600              # reap flags an active run with no active worker for this long


# ---------------------------------------------------------------- helpers
def run(args, cwd=None, check=True, timeout=None):
    try:
        r = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        if cwd and not Path(cwd).is_dir():
            if not check:
                return ""
            sys.exit(f"orch: {args[0]}: no such directory {cwd}")
        sys.exit(f"orch: {args[0]} not found")
    if check and r.returncode != 0:
        sys.exit(f"orch: {' '.join(map(str, args))} failed: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout.strip()


def git(cwd, *args, check=True):
    return run(["git", *args], cwd=cwd, check=check)


def repo_root(path):
    return str(Path(git(path, "rev-parse", "--path-format=absolute", "--git-common-dir")).parent)


def slug_of(path):
    return re.sub(r"[^A-Za-z0-9]+", "-", repo_root(path)).strip("-")


def git_dir(path):
    return Path(git(path, "rev-parse", "--path-format=absolute", "--git-dir"))


def default_branch(path):
    r = git(path, "symbolic-ref", "--short", "refs/remotes/origin/HEAD", check=False)
    return r.split("/", 1)[1] if "/" in r else "main"


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%S")


def read_json(p, default=None):
    try:
        return json.loads(Path(p).read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return default


def write_json(p, data):
    p = Path(p)
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_name(p.name + f".{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data, indent=2))
    tmp.replace(p)


def head(path):
    return git(path, "rev-parse", "HEAD")


def owner_info(path):
    return read_json(git_dir(path) / "orchestra-owner.json")


def patch_id(path, target):
    """Stable id of this branch's own change relative to origin/<target> (survives clean rebases)."""
    base = git(path, "merge-base", "HEAD", f"origin/{target}", check=False)
    if not base:
        return None
    diff = subprocess.run(["git", "diff", base, "HEAD"], cwd=path, capture_output=True, text=True).stdout
    if not diff:
        return None
    out = subprocess.run(["git", "patch-id", "--stable"], input=diff, capture_output=True, text=True).stdout
    return out.split()[0] if out else None


def have_cmux():
    return bool(shutil.which(CMUX))


def no_cmux():
    sys.stderr.write(f"orch: cmux not found ({CMUX}) — install cmux (macOS, see README → Requirements) "
                     f"or set ORCH_CMUX to its binary, then retry\n")
    sys.exit(2)


def need_cmux():
    """Commands that only make sense with cmux stop here with one line instead of a traceback."""
    if not have_cmux():
        no_cmux()


def cmux(*args, timeout=10):
    """Run cmux; a missing/unrunnable binary or a hang reads as a failed call (returncode 127/124), never a traceback."""
    try:
        return subprocess.run([CMUX, *args], capture_output=True, text=True, timeout=timeout)
    except OSError as e:  # not found, not executable, no #! line
        return subprocess.CompletedProcess([CMUX, *args], 127, "", f"cmux not runnable: {e}")
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess([CMUX, *args], 124, "", "cmux timed out")


def cmux_identify():
    try:
        return json.loads(cmux("identify", "--json").stdout)["caller"]
    except Exception:
        return {}


def cmux_workspace():
    """This session's address: its cmux SURFACE (a workspace may hold a coordinator + worker panes)."""
    return cmux_identify().get("surface_ref")


def cmux_nodes():
    """Every live workspace and surface across all windows: {ref: (uuid or None, title, its workspace ref)}, or None
    when cmux can't tell (no cmux, not running, hung, unreadable): unknown, never "everyone is dead".
    Short refs (workspace:N) are reused once a workspace closes; the uuid (`--id-format both`) is stable."""
    r = cmux("tree", "--all", "--json", "--id-format", "both")
    if r.returncode not in (0, 124, 127):  # a cmux from before --id-format: refs only (missing/hung: no second try)
        r = cmux("tree", "--all", "--json")
    if r.returncode != 0:
        return None
    try:
        tree = json.loads(r.stdout)
    except ValueError:
        return None
    nodes = {}
    def walk(o, ws):
        if isinstance(o, dict):
            ref = o.get("ref")
            if isinstance(ref, str) and re.fullmatch(r"(?:workspace|surface):\d+", ref):
                ws = ref if ref.startswith("workspace:") else ws
                uid = o.get("id")
                nodes[ref] = (uid if isinstance(uid, str) and uid else None, o.get("title"), ws)
            for v in o.values():
                walk(v, ws)
        elif isinstance(o, list):
            for v in o:
                walk(v, ws)
    walk(tree, None)
    return nodes


def cmux_live_workspaces(nodes=False):
    """Every live workspace and surface ref and uuid across all windows (None: unknown). nodes: cmux_nodes() already read."""
    nodes = cmux_nodes() if nodes is False else nodes
    if nodes is None:
        return None
    return set(nodes) | {uid for uid, _, _ in nodes.values() if uid}


def has_ids(live):
    """The live set can vouch for a uuid: its tree lists uuids, or lists nothing at all (then nobody is alive).
    False for a tree of refs only (a cmux from before --id-format)."""
    return not live or any(not re.fullmatch(r"(?:workspace|surface):\d+", x) for x in live)


def worker_live(wk, live):
    """The worker's pane is live: by its surface uuid when spawn recorded one and the tree lists uuids (a reused
    surface:N is someone else's), else by its ref (records from before ids, or a cmux that lists no uuids: a listed
    ref may be reused, so it reads as alive — never the other way round). live None (unknown) → True."""
    if live is None:
        return True
    if wk.get("surface_id") and has_ids(live):
        return wk["surface_id"] in live
    return wk.get("workspace") in live


def close_target(ref, uid, title, nodes):
    """(what to pass to `workspace close`, why it is skipped, retry) for a workspace orchestra opened as `ref`/`uid`
    named `title`. With its uuid: that uuid while it is live (a uuid can't name anyone else). Without one (opened before
    ids were recorded, or a cmux that lists none): the ref only while it still names a workspace titled `title` — a
    reused workspace:N is someone else's. retry: it couldn't be told, so the cleanup isn't finished. (None, None,
    False): already gone."""
    live = cmux_live_workspaces(nodes)
    if uid and (live is None or has_ids(live)):
        return (uid if live is None or uid in live else None), None, False
    if nodes is None:
        return None, f"{ref} skipped: cmux unreadable and no stable id to close it by", True
    if ref not in nodes:
        return None, None, False
    node_id, now_title, _ = nodes[ref]
    if now_title == title:
        return node_id or ref, None, False
    return None, f"{ref} skipped: it now names another workspace ({now_title or 'untitled'})", False


def cmux_group_for(workspace, key, name):
    """The workspace group holding `workspace`; creates one anchored on it (idempotent per run) if none."""
    try:
        out = cmux("workspace-group", "list", "--json").stdout
        for g in json.loads(out).get("groups", []):
            if workspace in g.get("member_workspace_refs", []):
                if g.get("anchor_workspace_ref") == workspace:
                    return g["ref"]
                # coordinator sits in another group (stale run, or as a plain member): take it out so it heads a new one
                cmux("workspace-group", "remove", "--workspace", workspace)
                break
    except Exception:
        pass
    out = cmux("workspace-group", "create", "--name", name, "--from", workspace, "--idempotency-key", key).stdout
    m = re.search(r"workspace_group:\d+", out)
    return m.group(0) if m else None


def cmux_first_surface(workspace, nodes):
    """(ref, uuid) of the first surface inside `workspace` (the terminal a new workspace starts with), or (None, None)."""
    for ref, (uid, _, ws) in (nodes or {}).items():
        if ref.startswith("surface:") and ws == workspace:
            return ref, uid
    return None, None


def port_in_use(p):
    with socket.socket() as sk:
        sk.settimeout(0.2)
        return sk.connect_ex(("127.0.0.1", p)) == 0


def remember_block(base, owner):
    """Record that orchestra handed port block `base` to `owner` (reap's proof the block was ever orchestra's)."""
    if isinstance(owner, str) and owner and (read_json(PORT_HISTORY / f"{base}.json") or {}).get("owner") != owner:
        write_json(PORT_HISTORY / f"{base}.json", {"owner": owner, "at": now()})


def alloc_ports(owner, dry=False):
    """The owner's port block (allocated on first call). dry: only report which block it would get."""
    pd = LOCKS / "ports"
    if not dry:
        pd.mkdir(parents=True, exist_ok=True)
    for x in pd.glob("*"):
        if x.name.isdigit() and (read_json(x / "owner.json") or {}).get("owner") == owner:
            if not dry:
                remember_block(int(x.name), owner)
            return int(x.name)
    for base in range(PORT_BASE, PORT_MAX, PORT_BLOCK):
        if any(port_in_use(p) for p in range(base, base + PORT_BLOCK)):
            continue
        if dry:
            if (pd / str(base)).exists():
                continue
            return base
        if take_lock(pd / str(base), {"owner": owner, "at": now()}):
            remember_block(base, owner)
            return base
    sys.exit("orch: no free port block")


def release_ports(owner):
    n = 0
    for x in (LOCKS / "ports").glob("*"):
        o = read_json(x / "owner.json")
        if (o or {}).get("owner") == owner and x.name.isdigit():
            remember_block(int(x.name), owner)
        if (o or {}).get("owner") == owner and steal_lock(x, o):
            n += 1
    return n


def cmux_message(target, text, sender):
    if not target:
        return False
    return cmux("agent", "message", target, "--from", sender, "--", text, timeout=20).returncode == 0


def runs_for(slug, status="active"):
    for d in sorted(RUNS.glob("*")):
        r = read_json(d / "run.json")
        if r and r.get("repo_slug") == slug and (status is None or r.get("status") == status):
            yield d, r


def workers_of(run_dir, status="active"):
    for w in sorted((run_dir / "workers").glob("*.json")):
        wk = read_json(w)
        if not isinstance(wk, dict) or "name" not in wk or "slice" not in wk:
            continue  # not a worker record (e.g. stray config files)
        if status is None or wk.get("status") == status:
            yield w, wk


def caffeinate_pid():
    """pid of the caffeinate orchestra started, if it is still running."""
    try:
        pid = int(CAFF_PID.read_text())
    except (FileNotFoundError, ValueError):
        return None
    cmd = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], capture_output=True, text=True).stdout
    try:
        started = CAFF_BIN.read_text().strip()
    except OSError:
        started = ""
    # ORCH_CAFFEINATE may name another binary, and a later call may run without it: the recorded name counts too
    names = {"caffeinate", os.path.basename(CAFFEINATE or "caffeinate")} | ({started} if started else set())
    return pid if re.search(rf"(?:^|[\s/])(?:{'|'.join(map(re.escape, names))}) -is\s*$", cmd) else None


def caffeinate_hold():
    """Keep the Mac awake while any run is active (idempotent across runs)."""
    if not CAFFEINATE or caffeinate_pid():
        return
    try:
        p = subprocess.Popen([CAFFEINATE, "-is"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
    except FileNotFoundError:
        return
    CAFF_PID.parent.mkdir(parents=True, exist_ok=True)
    CAFF_BIN.write_text(os.path.basename(CAFFEINATE))
    CAFF_PID.write_text(str(p.pid))


def caffeinate_release():
    pid = caffeinate_pid()
    if pid:
        try:
            os.kill(pid, 15)
        except ProcessLookupError:
            pass
    CAFF_PID.unlink(missing_ok=True)
    CAFF_BIN.unlink(missing_ok=True)
    return bool(pid)


def file_lock_dir(slug, rel):
    return LOCKS / slug / "files" / hashlib.sha1(rel.encode()).hexdigest()[:16]


# ---------------------------------------------------------------- coordinator commands
def cmd_new_run(a):
    root = repo_root(a.repo)
    slug = re.sub(r"[^a-z0-9]+", "-", a.title.lower()).strip("-")[:24] or "run"
    base_id = f"{time.strftime('%m%d-%H%M')}-{slug}"
    git(root, "fetch", "--quiet", "origin")
    b = default_branch(root)
    excl = Path(git(root, "rev-parse", "--path-format=absolute", "--git-common-dir")) / "info" / "exclude"
    excl.parent.mkdir(parents=True, exist_ok=True)
    if ".claude/worktrees/" not in (excl.read_text() if excl.exists() else ""):
        with open(excl, "a") as f:  # keep worker worktrees out of `git add .` without touching tracked files
            f.write("\n.claude/worktrees/\n")
    info = {"title": a.title, "repo": root, "repo_slug": slug_of(root),
            "default_branch": b, "target": b, "base_sha": git(root, "rev-parse", f"origin/{b}"),
            "coordinator": a.coordinator or cmux_workspace(),
            "coordinator_workspace": a.coordinator_workspace or cmux_identify().get("workspace_ref"),
            "status": "active", "created": now()}
    RUNS.mkdir(parents=True, exist_ok=True)
    for n in range(1, 1000):  # same title twice in one minute → -2, -3 (mkdir claims the id atomically)
        run_id = base_id if n == 1 else f"{base_id}-{n}"
        d = RUNS / run_id
        try:
            d.mkdir()
            break
        except FileExistsError:
            continue
    else:
        sys.exit(f"orch: no free run id for {base_id}")
    write_json(d / "run.json", {"id": run_id, **info})
    for sub in ("slices", "artifacts", "workers"):
        (d / sub).mkdir(parents=True, exist_ok=True)
    caffeinate_hold()
    print(run_id)


def cmd_run_branch(a):
    """Multi-slice runs: create origin/orch/<run> at origin/<default>; workers push there."""
    p = RUNS / a.run / "run.json"
    r = read_json(p) or sys.exit(f"orch: no run {a.run}")
    br = f"orch/{a.run}"
    git(r["repo"], "fetch", "--quiet", "origin")
    git(r["repo"], "push", "--quiet", "origin", f"origin/{r['default_branch']}:refs/heads/{br}")
    git(r["repo"], "fetch", "--quiet", "origin")
    r["target"] = br
    write_json(p, r)
    print(br)


def cmd_baseline(a):
    """Run every gate twice on a clean detached checkout of origin/<branch>; flag flaky gates."""
    r = read_json(RUNS / a.run / "run.json") or sys.exit(f"orch: no run {a.run}")
    root = r["repo"]
    git(root, "fetch", "--quiet", "origin")
    ref = f"origin/{a.branch or r['default_branch']}"
    tmp = Path(tempfile.mkdtemp(prefix=f"orch-baseline-{a.run}-"))
    wt = tmp / "wt"
    git(root, "worktree", "add", "--detach", str(wt), ref)
    try:
        if a.setup:
            subprocess.run(["bash", "-lc", a.setup], cwd=wt, capture_output=True, text=True)
        results = []
        for cmd in a.cmd:
            runs_ = []
            for i in range(2):
                p = subprocess.run(["bash", "-lc", cmd], cwd=wt, capture_output=True, text=True)
                log = RUNS / a.run / "artifacts" / "baseline" / f"{hashlib.sha1(cmd.encode()).hexdigest()[:8]}-{i}.log"
                log.parent.mkdir(parents=True, exist_ok=True)
                log.write_text(p.stdout + p.stderr)
                runs_.append({"exit": p.returncode, "log": str(log)})
            results.append({"cmd": cmd, "runs": runs_, "flaky": runs_[0]["exit"] != runs_[1]["exit"]})
        data = {"ref": ref, "sha": git(wt, "rev-parse", "HEAD"), "at": now(), "results": results}
        write_json(RUNS / a.run / "baseline.json", data)
        for x in results:
            print(f"{'FLAKY' if x['flaky'] else ('ok   ' if x['runs'][0]['exit'] == 0 else 'FAIL ')}  {x['cmd']}  (logs: {x['runs'][0]['log']})")
    finally:
        git(root, "worktree", "remove", "--force", str(wt), check=False)
        shutil.rmtree(tmp, ignore_errors=True)


def cmd_add_worker(a):
    d = RUNS / a.run
    r = read_json(d / "run.json") or sys.exit(f"orch: no run {a.run}")
    # a pane's own uuid only: a workspace's would later be sent to close-surface
    node = (cmux_nodes() or {}).get(a.workspace) if have_cmux() and a.workspace.startswith("surface:") else None
    write_json(d / "workers" / f"{a.slice}.json", {
        "run": a.run, "slice": a.slice, "name": f"{a.run}-{a.slice}", "workspace": a.workspace,
        "surface_id": node[0] if node else None,  # stable: close/liveness/messages use it (a surface:N is reused)
        "target": r["target"], "status": "active", "started": now()})
    print(f"{a.run}-{a.slice} → pushes to {r['target']}")


def cmd_lock(a):
    slug, taken = slug_of(a.repo), []
    for rel in a.files:
        d = file_lock_dir(slug, rel)
        info = {"owner": a.owner, "file": rel, "at": now()}
        if take_lock(d, info):
            taken.append((d, info))
        else:
            holder = (read_json(d / "owner.json") or {}).get("owner", "?")
            if holder == a.owner:
                continue
            for t, info in taken:  # all-or-nothing, and only the locks this call took
                steal_lock(t, info)
            sys.exit(f"LOCKED {rel} by {holder}")
    print(f"locked {len(a.files)} file(s) for {a.owner}")


def unlock(repo, owner, files=()):
    base, n = LOCKS / slug_of(repo) / "files", 0
    for d in base.glob("*"):
        o = read_json(d / "owner.json")
        if (o or {}).get("owner") == owner and (not files or o.get("file") in files) and steal_lock(d, o):
            n += 1
    return n


def cmd_unlock(a):
    print(f"released {unlock(a.repo, a.owner, a.files)} lock(s)")


def cmd_locks(a):
    slug = slug_of(a.repo)
    for d in sorted((LOCKS / slug / "files").glob("*")):
        o = read_json(d / "owner.json") or {}
        print(f"{o.get('owner', '?'):40} {o.get('file', '?')}")
    m = read_json(LOCKS / slug / "merge" / "owner.json")
    if m:
        print(f"MERGE LOCK: {m.get('owner')} since {int(time.time() - m.get('at', 0))}s ago")


def cmd_criteria_init(a):
    """criteria file: JSON list of {id, text, check} — written by the coordinator from the spec."""
    items = json.loads(Path(a.file).read_text())
    for c in items:
        if not {"id", "text"} <= set(c):
            sys.exit("orch: each criterion needs id and text")
        c.setdefault("check", "")
        c.update(status="pending", sha=None, evidence="")
    write_json(RUNS / a.run / "criteria.json", items)
    print(f"{len(items)} criteria registered")


def cmd_criteria_add(a):
    """Append criteria (JSON list of {id, text, check}) without resetting the ones already recorded."""
    p = RUNS / a.run / "criteria.json"
    items = read_json(p, [])
    have = {c["id"] for c in items}
    new = json.loads(Path(a.file).read_text())
    for c in new:
        if not {"id", "text"} <= set(c):
            sys.exit("orch: each criterion needs id and text")
        if c["id"] in have:
            sys.exit(f"orch: {c['id']} already exists (criteria-add never overwrites)")
        c.setdefault("check", "")
        c.update(status="pending", sha=None, evidence="")
    write_json(p, items + new)
    print(f"added {len(new)} criteria ({len(items) + len(new)} total)")


def cmd_ports(a):
    """Port block for a coordinator-run job (e.g. integration reviewer/verifier) so reap treats it as owned."""
    if not (RUNS / a.run / "run.json").exists():
        sys.exit(f"orch: no run {a.run}")
    owner = f"{a.run}-{a.name}"
    if not a.release:
        caffeinate_hold()  # integration work on a run reap found idle
    if a.release:
        print(f"released {release_ports(owner)} block(s) for {owner}")
        return
    base = alloc_ports(owner)
    print(f"{base} {base + PORT_BLOCK - 1}")


def cmd_criteria_check(a):
    items = read_json(RUNS / a.run / "criteria.json") or sys.exit("orch: no criteria.json")
    bad = [c for c in items if c["status"] != "pass" or (a.sha and c.get("sha") != a.sha)]
    for c in items:
        ok = c["status"] == "pass" and (not a.sha or c.get("sha") == a.sha)
        print(f"{'PASS' if ok else c['status'].upper():8} {c['id']}  {c['text'][:70]}  {(c.get('sha') or '')[:10]}")
    if bad:
        sys.exit(f"orch: {len(bad)} criterion(s) not passing{' at ' + a.sha[:10] if a.sha else ''}")


def cmd_doctor(a):
    live = cmux_live_workspaces()
    slugs = set()
    for run_dir in sorted(RUNS.glob("*")):
        r = read_json(run_dir / "run.json") or {}
        if r.get("status") != "active" or (a.run and r["id"] != a.run):
            continue
        slugs.add(r["repo_slug"])
        print(f"{r['id']}  coord={r.get('coordinator')}  target={r.get('target')}")
        for w, wk in workers_of(run_dir):
            alive = worker_live(wk, live)
            prog = run_dir / "slices" / f"{wk['slice']}.progress.md"
            age = int(time.time() - prog.stat().st_mtime) if prog.exists() else None
            print(f"   {wk['slice']:18} {'alive' if alive else 'DEAD '}  progress {'never' if age is None else f'{age // 60}m ago'}")
            if not alive and a.fix:
                wk.update(status="dead", died=now())
                write_json(w, wk)
                print(f"      → marked dead. Respawn (resumes from its progress file): "
                      f"orch spawn --run {r['id']} --slice {wk['slice']} --resume")
    live_owner = owner_rule()

    def orphan(d):  # owner.json missing: only an orphan once past the grace period (a taker may be mid-write)
        o = read_json(d / "owner.json")
        if not isinstance(o, dict):
            return dir_age(d) > LOCK_GRACE_SECS, o
        return not live_owner(o.get("owner")), o

    def report(d, o, what):
        gone = a.fix and steal_lock(d, o)  # unchanged since judged, else someone retook it: leave it
        print(f"   orphan {what}" + (" → released" if gone else " → changed meanwhile, kept" if a.fix else ""))
    for x in sorted((LOCKS / "resources").glob("*")):
        bad, o = orphan(x)
        if bad:
            report(x, o, f"{x.name} lock by {(o or {}).get('owner')}")
    for x in sorted((LOCKS / "ports").glob("*")):
        bad, o = orphan(x)
        if bad:
            report(x, o, f"port block {x.name} by {(o or {}).get('owner')}")
    for s in sorted(slugs):
        m = LOCKS / s / "merge"
        if m.is_dir():
            bad, o = orphan(m)
            if bad:
                report(m, o, f"MERGE LOCK held by {(o or {}).get('owner')}")
        for d in sorted((LOCKS / s / "files").glob("*")):
            bad, fo = orphan(d)
            if bad:
                report(d, fo, f"file lock {(fo or {}).get('file')} by {(fo or {}).get('owner')}")


def cmd_finish_worker(a):
    w = RUNS / a.run / "workers" / f"{a.slice}.json"
    wk = read_json(w) or sys.exit(f"orch: no worker {a.slice} in {a.run}")
    if wk.get("status") == "active":
        wk["status"] = a.status
    wk["finished"] = now()
    write_json(w, wk)
    r = read_json(RUNS / a.run / "run.json")
    print(f"released {unlock(r['repo'], wk['name'])} file lock(s), {release_ports(wk['name'])} port block(s)")


def cmd_spawn(a):
    """Open a worker in its own workspace inside the coordinator's sidebar group (the group is created,
    anchored on the coordinator's workspace, if it has none). Allocates the worker's own port block."""
    d = RUNS / a.run
    r = read_json(d / "run.json") or sys.exit(f"orch: no run {a.run}")
    brief = d / "slices" / f"{a.slice}.md"
    if not brief.exists():
        sys.exit(f"orch: no brief {brief}")
    name, root = f"{a.run}-{a.slice}", r["repo"]
    trusted = ((read_json(Path.home() / ".claude.json", {}) or {}).get("projects", {}).get(root, {}) or {}).get("hasTrustDialogAccepted")
    if not trusted and not os.environ.get("ORCH_SKIP_TRUST"):
        if a.dry_run:
            sys.exit(f"orch: dry run — {root} is not trusted yet, so spawn would refuse (and add it to NEEDS YOU)")
        add_need(d, f"Trust this folder: in a terminal run `cd {root} && claude`, accept the trust prompt, then /exit")
        sys.exit(f"orch: {root} is not trusted yet — `claude -w` would hang. Added to NEEDS YOU; spawn again once trusted.")
    wt = f"{root}/.claude/worktrees/{name}"
    if not a.dry_run:
        need_cmux()
    if a.resume and not Path(wt).exists():
        sys.exit(f"orch: --resume but no worktree at {wt}")
    port = alloc_ports(name, dry=a.dry_run)
    env = f"ORCH_PORT={port} ORCH_PORT_END={port + PORT_BLOCK - 1}"
    worker = f"/worker {brief}"
    # The coordinator keeps every MCP server (console tools, real Chrome). Workers load only the MCP servers they use (worker-mcp.json: playwright, context7) — the full set costs
    # ~1GB more per worker. Native slices launch normally so cmux injects its Computer Use server (cmux only
    # does that, and only hands over its socket token, when no --strict-mcp-config is given).
    m = re.search(r"^[\s>*`-]*MODEL:[\s*`]*([A-Za-z][\w.\[\]-]*)", brief.read_text(), re.M)  # brief `MODEL: sonnet` overrides
    model = f"--model {shlex.quote(m.group(1) if m else 'opus')} "
    lean = ""
    if (HOME / "worker-mcp.json").exists() and not (a.all_mcp or a.native):
        lean = f"--strict-mcp-config --mcp-config {shlex.quote(str(HOME / 'worker-mcp.json'))} "
    if a.resume:
        cmdline = f"cd {shlex.quote(wt)} && {env} claude {lean}{model}-n {name} --permission-mode auto {shlex.quote(worker)}"
    else:
        cmdline = f"cd {shlex.quote(root)} && {env} claude {lean}{model}-w {name} -n {name} --permission-mode auto {shlex.quote(worker)}"
    # Each worker gets its own workspace in the coordinator's sidebar group (created on first spawn).
    ws = r.get("coordinator_workspace")
    if a.dry_run:
        print(f"dry run — nothing started, no cmux/claude called, no ports allocated\n"
              f"group: {'the sidebar group anchored on ' + ws + ' (created if none)' if ws else 'none (no coordinator workspace)'}\n"
              f"ports: {port}-{port + PORT_BLOCK - 1} (first free block now)\n"
              f"would run: {shlex.join([CMUX, 'new-workspace', '--name', name, '--cwd', root, '--command', cmdline, '--focus', 'false'] + (['--group', '<that group>', '--group-placement', 'end'] if ws else []))}\n"
              f"worker command: {cmdline}")
        return
    caffeinate_hold()  # a run reap found idle (and released caffeinate for) is busy again
    group = cmux_group_for(ws, a.run, f"{Path(root).name} · {r.get('title', a.run)}") if ws else None
    if group and r.get("group") != group:
        r = read_json(d / "run.json") or r  # fresh copy: don't undo a write made since we read it
        r["group"] = group  # end-run dissolves it
        write_json(d / "run.json", r)
    args = [CMUX, "new-workspace", "--name", name, "--cwd", root, "--command", cmdline, "--focus", "false"]
    if group:
        args += ["--group", group, "--group-placement", "end"]
    res = cmux(*args[1:], timeout=None)  # no timeout: a late reply would leave an untracked worker running
    out = res.stdout.strip()
    wm = re.search(r"workspace:\d+", out)
    nodes = cmux_nodes() if wm else None
    surface, surface_id = cmux_first_surface(wm.group(0), nodes) if wm else (None, None)
    if not surface:
        release_ports(name)
        sys.exit(f"orch: could not read the new workspace's surface from: {out or '(no output)'}"
                 + (f" — cmux said: {res.stderr.strip()}" if res.stderr.strip() else ""))
    write_json(d / "workers" / f"{a.slice}.json", {
        "run": a.run, "slice": a.slice, "name": name, "workspace": surface, "ws_ref": wm.group(0), "target": r["target"],
        "ws_id": nodes[wm.group(0)][0] if wm.group(0) in nodes else None, "surface_id": surface_id,  # stable: close/liveness use these
        "ports": [port, port + PORT_BLOCK - 1], "lean_mcp": bool(lean), "status": "active", "started": now()})
    msg = open_dash(a.run)
    if msg:
        print(msg)
    print(f"{name} → workspace {wm.group(0)} ({surface}) in {group or 'no group'}, ports {port}-{port + PORT_BLOCK - 1}, pushes to {r['target']}")


# ---------------------------------------------------------------- cleanup (nothing finished keeps running)
ORCH_PORT_RANGE = (PORT_BASE, PORT_MAX + PORT_BLOCK - 1)


def _ps():
    out = subprocess.run(["ps", "-axo", "pid=,ppid=,rss=,command="], capture_output=True, text=True).stdout
    rows = {}
    for line in out.splitlines():
        parts = line.split(None, 3)
        if len(parts) == 4 and parts[0].isdigit():
            rows[int(parts[0])] = (int(parts[1]), int(parts[2]), parts[3])
    return rows


def _cwds():
    out = subprocess.run(["lsof", "-d", "cwd", "-Fpn"], capture_output=True, text=True).stdout
    m, pid = {}, None
    for line in out.splitlines():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("n") and pid:
            m[pid] = line[1:]
    return m


def _listeners(lo, hi):
    """{pid: [ports]} for TCP listeners in [lo, hi]."""
    out = subprocess.run(["lsof", "-nP", f"-iTCP:{lo}-{hi}", "-sTCP:LISTEN", "-Fpn"], capture_output=True, text=True).stdout
    m, pid = {}, None
    for line in out.splitlines():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("n") and pid:
            mm = re.search(r":(\d+)$", line)
            if mm:
                m.setdefault(pid, []).append(int(mm.group(1)))
    return m


def _protected(ps):
    """This process and its ancestors (e.g. the coordinator's claude) are never killed."""
    keep, pid = set(), os.getpid()
    while pid and pid not in keep:
        keep.add(pid)
        pid = ps.get(pid, (0,))[0]
    return keep


def path_re(p, prefix=False, others=()):
    """A regex finding path p in text as a whole path component (p/... or p alone, so .../<run>-S1 never matches
    .../<run>-S10). prefix=True: p may be followed by any non-alphanumeric separator (/tmp/<owner>-dd), except where
    the text continues into one of `others`, the longer names of other owners (/tmp/<run>-api-docs-dd isn't api's)."""
    end = r"(?![A-Za-z0-9])" if prefix else r"(?![A-Za-z0-9_.-])"  # a name character after p means another name
    longer = [o[len(p):] for o in others if o.startswith(p) and len(o) > len(p) and not o[len(p)].isalnum()]
    skip = "".join(f"(?!{re.escape(t)}(?![A-Za-z0-9]))" for t in longer)
    return re.compile(re.escape(p) + skip + end)


def resolved(p):
    """p with its parent directory resolved (/tmp/x → /private/tmp/x on macOS): lsof reports resolved cwds."""
    return os.path.join(os.path.realpath(os.path.dirname(p)), os.path.basename(p))


def owner_names():
    """Every owner name orchestra knows: workers and integration of every run, and port-block owners (held or
    recorded) such as coordinator jobs (`orch ports --name`). For path_re's `others`."""
    names = set()
    for d in RUNS.glob("*"):
        names.add(f"{d.name}-integrate")
        names |= {wk["name"] for _, wk in workers_of(d, status=None) if isinstance(wk.get("name"), str)}
    for f in [*PORT_HISTORY.glob("*.json"), *((LOCKS / "ports").glob("*/owner.json"))]:
        o = (read_json(f) or {}).get("owner")
        if isinstance(o, str) and o:
            names.add(o)
    return names


def sweep(pids=(), ports=None, paths=(), prefixes=(), others=(), dry=False):
    """Kill pids + listeners on ports + anything running in/for paths (whole directories) or prefixes (/tmp/<owner>
    and /tmp/<owner>-*, never another owner's longer name in `others`), with their descendants.
    Returns (killed pids, freed RSS in MB)."""
    ps = _ps()
    targets = set(pids)
    if ports:
        targets |= set(_listeners(*ports))
    if paths or prefixes:
        pats = [path_re(v) for p in paths for v in {p, resolved(p)}]
        pats += [path_re(p, prefix=True, others=others) for p in prefixes]
        pats += [path_re(resolved(p), prefix=True, others={resolved(o) for o in others}) for p in prefixes]
        for pid, cwd in _cwds().items():
            if any(x.match(cwd) for x in pats):
                targets.add(pid)
        for pid, (_, _, cmd) in ps.items():
            if any(x.search(cmd) for x in pats):
                targets.add(pid)
    kids = {}
    for pid, (ppid, _, _) in ps.items():
        kids.setdefault(ppid, []).append(pid)
    stack = list(targets)
    while stack:
        for c in kids.get(stack.pop(), []):
            if c not in targets:
                targets.add(c)
                stack.append(c)
    targets = {t for t in targets if t in ps} - _protected(ps)
    mb = sum(ps[t][1] for t in targets) / 1024
    if targets and not dry:
        for t in targets:
            try:
                os.kill(t, 15)
            except ProcessLookupError:
                pass
        for _ in range(6):
            time.sleep(0.5)
            alive = [t for t in targets if subprocess.run(["kill", "-0", str(t)], capture_output=True).returncode == 0]
            if not alive:
                break
        for t in alive if targets else []:
            try:
                os.kill(t, 9)
            except ProcessLookupError:
                pass
    return targets, mb


LEFTOVERS = HOME / "state" / "worktree-leftovers.json"  # worktrees whose removal failed halfway, to finish later


def remove_worktree(root, wt):
    """git worktree remove --force --force. A remove that fails halfway (a file it couldn't delete) has already dropped
    git's record, so every later remove says "not a working tree" and the directory would stay forever. So: a
    directory that was this repo's worktree (its .git points into this repo's worktrees/) and survives the remove is
    remembered, and what is left of it is deleted once git no longer lists it — now or on a retry, even if its .git
    went too. Any other directory at that path is never deleted."""
    real = os.path.realpath(wt)
    dot = Path(wt) / ".git"
    try:
        m = re.match(r"gitdir:\s*(.+)", dot.read_text().strip()) if dot.is_file() else None
    except OSError:
        m = None
    common = os.path.realpath(git(root, "rev-parse", "--path-format=absolute", "--git-common-dir", check=False) or "/nonexistent")
    ours = bool(m) and os.path.dirname(os.path.realpath(os.path.join(wt, m.group(1)))) == os.path.join(common, "worktrees")
    ident = lambda: (lambda st: [st.st_dev, st.st_ino])(os.stat(wt)) if os.path.isdir(wt) else None
    before = ident()
    git(root, "worktree", "remove", "--force", "--force", wt, check=False)
    LEFTOVERS.parent.mkdir(parents=True, exist_ok=True)
    with open(f"{LEFTOVERS}.lock", "a") as lock:  # concurrent end-run / reap: never lose an entry
        fcntl.flock(lock, fcntl.LOCK_EX)
        # an entry names one directory (path + dev/inode): one removed by hand and made again there is someone else's
        left = [e for e in (read_json(LEFTOVERS, []) or []) if isinstance(e, dict) and os.path.isdir(e.get("path", ""))]
        now_id = ident()
        known = any(e["path"] == real and e.get("id") == now_id for e in left)
        if now_id and (ours or known):
            lst = subprocess.run(["git", "worktree", "list", "--porcelain"], cwd=root, capture_output=True, text=True)
            listed = {os.path.realpath(x[len("worktree "):]) for x in lst.stdout.splitlines() if x.startswith("worktree ")}
            if lst.returncode == 0 and real not in listed:  # git couldn't answer: never delete on a guess
                shutil.rmtree(wt, ignore_errors=True)
        now_id = ident()
        left = [e for e in left if e["path"] != real]
        if now_id and (known or (ours and now_id == before)):
            left.append({"path": real, "id": now_id})
        write_json(LEFTOVERS, left)


def cleanup_worker(r, wk, full=True, dry=False, names=None):
    """full: close pane, kill its processes, remove worktree/branch/derived data, release locks+ports.
    not full (dead worker): kill leftover processes only, keep the worktree so it can resume.
    names: owner_names(), when the caller cleans several workers."""
    name, root = wk["name"], r["repo"]
    wt = f"{root}/.claude/worktrees/{name}"
    did = []
    ports = tuple(wk["ports"]) if wk.get("ports") else None
    if ports:  # sweep the block only while this worker still holds it: once released (or handed to someone else)
        # an unrelated process may listen there; orphan_listeners' tie-to-a-run rule covers a released block
        holder = (read_json(LOCKS / "ports" / str(ports[0]) / "owner.json") or {}).get("owner")
        if holder != name:
            ports = None
    others = {f"/tmp/{o}" for o in (owner_names() if names is None else names) if o != name}
    tmp = dict(paths=(wt,), prefixes=(f"/tmp/{name}",), others=others)
    _, before_mb = sweep(ports=ports, **tmp, dry=True)  # measure before the pane closes
    if full and wk.get("workspace") and have_cmux():
        nodes = cmux_nodes()
        if wk.get("ws_ref"):
            target, skip, retry = close_target(wk["ws_ref"], wk.get("ws_id"), name, nodes)
            args = ["workspace", "close", "--workspace", target, "--force"]
        else:  # a pane (orch add-worker, or older workers opened in the coordinator's workspace): only its surface
            # uuid can name it — a pane's title is the terminal's, so a reused surface:N can't be told from its own
            live = cmux_live_workspaces(nodes)
            uid, retry = wk.get("surface_id"), False
            if uid and (live is None or has_ids(live)):  # a uuid names nobody else: close it even if cmux can't list
                target, skip = (uid if live is None or uid in live else None), None
            elif uid:
                target, skip, retry = None, f"{wk['workspace']} skipped: cmux lists no stable ids to close it by", True
            else:
                target, skip = None, f"{wk['workspace']} skipped: a pane recorded without a stable id"
            args = ["close-surface", "--surface", target, "--force"]
        if skip:
            did.append(f"pane {skip}")
        if retry:
            did.append("pane unverified")
        if target:
            did.append("pane")
            if not dry:
                cmux(*args, timeout=30)
                time.sleep(2)  # the live session locks the worktree until it exits
    killed, mb = sweep(ports=ports, **tmp, dry=dry)
    mb = max(mb, before_mb)
    if killed or mb >= 1:
        did.append(f"~{mb:.0f}MB of processes")
    if full:
        if Path(wt).exists():
            did.append("worktree")
            if not dry:
                remove_worktree(root, wt)
        if not dry:
            git(root, "branch", "-D", f"worktree-{name}", check=False)
            own = path_re(f"/tmp/{name}", prefix=True, others=others)
            for x in Path("/tmp").glob(f"{name}*"):  # /tmp/<name> and /tmp/<name>-*, never /tmp/<run>-S10* for S1
                if own.match(str(x)):
                    shutil.rmtree(x, ignore_errors=True)
            unlock(root, name)
            release_ports(name)
            for res in (LOCKS / "resources").glob("*"):
                ro = read_json(res / "owner.json")
                o = (ro or {}).get("owner") or ""
                if o in (name, f"{name}-verify"):  # its own, never S10's for S1 or api-docs's for api
                    steal_lock(res, ro)
    return did, mb


def cmd_close(a):
    """Close a worker's pane, kill everything it started, remove its worktree + branch, free its locks/ports."""
    d = RUNS / a.run
    r = read_json(d / "run.json") or sys.exit(f"orch: no run {a.run}")
    w = d / "workers" / f"{a.slice}.json"
    wk = read_json(w) or sys.exit(f"orch: no worker {a.slice}")
    did, mb = cleanup_worker(r, wk)
    if wk.get("status") in ("active", "dead"):  # dead too: reap cleans a dead worker's processes only, never its tree
        wk["status"] = a.status or "done"
    wk["finished"] = now()
    done = cleanup_complete(r, wk, did)
    if done:  # else reap retries what didn't finish (a pane close that timed out, a worktree git couldn't remove)
        wk["cleaned"] = now()
    write_json(w, wk)
    print(f"closed {wk['name']}: {', '.join(did) or 'nothing left running'}"
          + ("" if done else " — not finished (pane or worktree left); the next orch reap retries it"))


def sims_down(dry=False):
    """Delete orch-sim clones of finished owners. Never `simctl shutdown all`: that kills other workers' clones
    and the user's own simulators (and every test run's isolated ORCH_HOME looks like 'no active run')."""
    sim = Path(__file__).resolve().parent / "orch-sim"
    if not sim.exists():
        return ""
    p = subprocess.run([str(sim), "reap", *(["--dry-run"] if dry else [])], capture_output=True, text=True)
    out = (p.stdout + p.stderr).strip()
    return f"orch-sim reap{' --dry-run' if dry else ''}: {out}" if out else ""


def active_runs(except_run=None):
    """run.json of every active run (but except_run)."""
    out = []
    for d in sorted(RUNS.glob("*")):
        r = read_json(d / "run.json")
        if isinstance(r, dict) and r.get("status") == "active" and d.name != except_run:
            out.append(r)
    return out


def any_active_run(except_run=None):
    return bool(active_runs(except_run))


def run_of(owner, ids=None):
    """The run an owner name belongs to: the LONGEST run id it extends with "-" (so `X-2-S1` is run X-2's, not X's)."""
    ids = [d.name for d in RUNS.glob("*")] if ids is None else ids
    hits = [rid for rid in ids if owner and owner.startswith(f"{rid}-")]
    return max(hits, key=len) if hits else None


TERMINAL = ("done", "merged", "aborted")  # finished workers; `dead`/`restarted` keep their locks for --resume/respawn


def owner_rule(busy=False):
    """Lock/port owner → is it live? doctor and reap share this one rule:
    - `ops-*` (console chores outside runs): live;
    - a worker of an active run (`<run>-<slice>`, or its `<run>-<slice>-verify` job): live unless the worker finished
      (TERMINAL). busy=True (reap's idle check) counts only ACTIVE workers, so dead leftovers don't keep a run awake;
    - any other name under an active run (`<run>-integrate*`, `orch ports` blocks, locks taken before spawn): live;
    - anything else (ended runs, unknown names): not live."""
    rids = {r["id"] for r in active_runs() if r.get("id")}
    ids = [d.name for d in RUNS.glob("*")]
    workers = {wk["name"]: wk.get("status") for rid in rids for _, wk in workers_of(RUNS / rid, status=None)
               if wk.get("slice") != "integrate"}

    def live(o):
        if not o:
            return False
        if o.startswith("ops-"):
            return True
        if run_of(o, ids) not in rids:
            return False
        w = o[:-len("-verify")] if o.endswith("-verify") and o[:-len("-verify")] in workers else o
        if w not in workers:
            return True
        return workers[w] == "active" if busy else workers[w] not in TERMINAL
    return live


def lock_owners():
    """(lock dir, owner.json dict or None) for every orch lock and port block."""
    dirs = [*(LOCKS / "ports").glob("*"), *(LOCKS / "resources").glob("*"), *LOCKS.glob("*/merge"), *LOCKS.glob("*/files/*")]
    return [(x, read_json(x / "owner.json")) for x in dirs if not x.name.startswith(".")]


def dir_age(d):
    try:
        return time.time() - d.stat().st_mtime
    except FileNotFoundError:
        return 0


def ts(x):
    """Epoch of an orch timestamp (now() format), or None."""
    try:
        return time.mktime(time.strptime(x, "%Y-%m-%dT%H:%M:%S"))
    except (TypeError, ValueError):
        return None


def idle_secs(d, r, busy=()):
    """Seconds an active run has had no active worker and no file change; None if it has an active worker or is in
    `busy` (runs that took a live lock or port block within IDLE_RUN_SECS, e.g. a coordinator's integration verifier).
    Locks are reservations and outlive the work, so only a recent one counts as activity."""
    if d.name in busy or any(True for _ in workers_of(d)):
        return None
    last = [ts(r.get("created")) or 0]
    for _, wk in workers_of(d, status=None):
        last += [ts(wk.get(k)) or 0 for k in ("started", "finished", "merged", "died", "cleaned")]
    for sub in (d, d / "slices", d / "workers"):
        for f in sub.glob("*"):
            try:
                if f.is_file():
                    last.append(f.stat().st_mtime)
            except FileNotFoundError:
                pass  # a write_json temp file renamed away mid-scan
    return time.time() - max(last)


def orphan_listeners(dry=False):
    """Listeners on orchestra ports that orchestra can tie to itself and nobody live owns: the port's block was handed
    out by alloc_ports (held now, or released but in PORT_HISTORY) to an owner that is no longer live, and the process
    or one of its ancestors runs in a worktree of that owner's run (<repo>/.claude/worktrees/<run>-*). Anything else
    in the range (a database on 27017, a server orchestra never started, a port never handed out) is left alone."""
    listeners = _listeners(*ORCH_PORT_RANGE)
    if not listeners:
        return []
    live_owner, ids = owner_rule(), [d.name for d in RUNS.glob("*")]
    block_owner, held = {}, set()  # base -> owner it was handed to: the current holder, else the last one recorded
    for x in PORT_HISTORY.glob("*.json"):
        if x.stem.isdigit():
            block_owner[int(x.stem)] = (read_json(x) or {}).get("owner")
    for x in (LOCKS / "ports").glob("*"):
        if x.name.isdigit() and x.is_dir():
            o = (read_json(x / "owner.json") or {}).get("owner")
            if not o and dir_age(x) > LOCK_GRACE_SECS:  # no owner.json past the grace period: a dead taker's, not held
                continue
            block_owner[int(x.name)] = o
            held.add(int(x.name))
    wt_roots = {}  # run id -> its repo's worktree dirs (as given and resolved: lsof reports resolved paths)
    for rid in ids:
        repo = (read_json(RUNS / rid / "run.json") or {}).get("repo")
        if isinstance(repo, str) and repo:
            wt_roots[rid] = {f"{x}/.claude/worktrees/" for x in (repo, os.path.realpath(repo))}
    for b in () if dry else held:  # blocks held since before PORT_HISTORY existed get their record now, while the owner is known
        remember_block(b, block_owner[b])
    if not any((p - PORT_BASE) // PORT_BLOCK * PORT_BLOCK + PORT_BASE in block_owner for ps_ in listeners.values()
               for p in ps_):
        return []
    ps, cwds = _ps(), _cwds()
    keep = _protected(ps)

    def in_run_worktree(pid, rid):
        """pid or an ancestor runs in a worktree of run rid whose own owner is finished (a live worker's or the
        active integration's server on a released block is theirs, not an orphan)."""
        seen = set()
        while pid and pid > 1 and pid not in seen and pid not in keep:
            seen.add(pid)
            c = cwds.get(pid) or ""
            for root in wt_roots.get(rid, ()):
                wt = c[len(root):].split("/")[0] if c.startswith(root) else ""
                if wt and run_of(wt, ids) == rid and not live_owner(wt):
                    return True
            pid = ps.get(pid, (0,))[0]
        return False

    out = []
    for pid, ports in listeners.items():
        bases = {(p - PORT_BASE) // PORT_BLOCK * PORT_BLOCK + PORT_BASE for p in ports}
        # a held block whose holder is live (or not yet written: a lock being taken) keeps its listener;
        # a released block has no live holder, whoever it was last handed to
        if any(b in held and (live_owner(block_owner[b]) or not block_owner[b]) for b in bases):
            continue
        owners = [block_owner.get(b) for b in bases]
        rids = {run_of(o, ids) for o in owners if isinstance(o, str)} - {None}
        if any(in_run_worktree(pid, rid) for rid in rids):
            out.append(pid)
    return out


MERGED_GRACE_SECS = 10 * 60  # `orch merged` comes before the worker's merge-unlock and MERGED report


def still_merging(r, wk):
    """A merged worker that may still be finishing its own steps (unlock, MERGED report): merged within the grace
    period, or still holding the repo's merge lock (until that lock would be stale anyway)."""
    if wk.get("status") != "merged":
        return False
    age = time.time() - (ts(wk.get("merged")) or 0)
    if age < MERGED_GRACE_SECS:
        return True
    if age >= MERGE_LOCK_MAX_SECS:
        return False
    try:
        holder = (read_json(merge_dir(r["repo"]) / "owner.json") or {}).get("owner")
    except (Exception, SystemExit):  # can't tell who holds it: leave the worker alone this time
        return True
    return holder == wk.get("name")


def cleanup_complete(r, wk, did):
    """A full cleanup really finished: the worktree is gone and a pane it closed is no longer live (a close that timed
    out, or a worktree git couldn't remove, is retried by the next reap)."""
    if Path(f"{r['repo']}/.claude/worktrees/{wk['name']}").exists():
        return False
    if "pane unverified" in did:  # couldn't tell whose the pane is: try again next reap
        return False
    if "pane" in did:
        live = cmux_live_workspaces()
        return live is not None and not worker_live(wk, live)
    return True


def cmd_reap(a):
    """Clean up anything finished/dead that is still using memory. Safe to run any time (the 30-min heartbeat does)."""
    runs = [RUNS / a.run] if a.run else [RUNS / r["id"] for r in active_runs() if r.get("id")]
    live, total, lines, names = cmux_live_workspaces(), 0.0, [], owner_names()
    for d in runs:
        r = read_json(d / "run.json") or {}
        for w, wk in workers_of(d, status=None):
            if wk.get("status") == "active":
                if not worker_live(wk, live):
                    if not a.dry_run:
                        wk.update(status="dead", died=now())
                        write_json(w, wk)
                    did, mb = cleanup_worker(r, wk, full=False, dry=a.dry_run, names=names)
                    lines.append(f"{wk['name']}: pane gone → marked dead; {', '.join(did) or 'no leftovers'} (worktree kept for --resume)")
                    total += mb
                continue
            if wk.get("status") == "dead":
                did, mb = cleanup_worker(r, wk, full=False, dry=a.dry_run, names=names)
            elif wk.get("cleaned") or still_merging(r, wk):
                continue  # cleaned once already (nothing to redo every heartbeat), or not done reporting yet
            else:
                did, mb = cleanup_worker(r, wk, full=True, dry=a.dry_run, names=names)
                done = not a.dry_run and cleanup_complete(r, wk, did)
                if done and did:
                    wk["cleaned"] = now()
                    write_json(w, wk)
                elif done:
                    # nothing was left: record it once, as of its last event, without counting as activity
                    # (idle_secs reads these timestamps and the file's mtime); no event → retried, harmlessly
                    last = max((wk[k] for k in ("started", "finished", "merged", "died") if ts(wk.get(k))),
                               key=ts, default=None)
                    if last:
                        mtime = w.stat().st_mtime
                        write_json(w, dict(wk, cleaned=last))
                        os.utime(w, (mtime, mtime))
            if did:
                lines.append(f"{wk['name']} ({wk.get('status')}): {', '.join(did)}")
                total += mb
        integ = {"name": f"{d.name}-integrate", "ports": None}
        if r.get("status") not in (None, "active") and r.get("repo") and Path(r["repo"]).exists() and (
                Path(f"{r['repo']}/.claude/worktrees/{integ['name']}").exists()
                or git(r["repo"], "rev-parse", "-q", "--verify", f"refs/heads/{integ['name']}", check=False)):
            # an ended run whose integration end-run couldn't remove (NOT finished): retry it like a worker
            did, mb = cleanup_worker(r, integ, full=True, dry=a.dry_run, names=names)
            if not a.dry_run:
                git(r["repo"], "branch", "-D", integ["name"], check=False)
            left = not a.dry_run and not cleanup_complete(r, integ, did)
            lines.append(f"{integ['name']} (run {r.get('status')}): {', '.join(did) or 'branch'}"
                         + (f" — still NOT finished, retry with orch reap --run {d.name}" if left else ""))
            total += mb
        if r.get("repo") and Path(r["repo"]).exists() and not a.dry_run:
            git(r["repo"], "worktree", "prune", check=False)
    orphans = orphan_listeners(dry=a.dry_run)
    if orphans:
        killed, mb = sweep(pids=orphans, dry=a.dry_run)
        lines.append(f"orphan servers on orchestra ports: {len(killed)} process(es) {mb:.0f}MB")
        total += mb
    # active runs nobody is working on: flag them; if every active run is idle, stop keeping the Mac awake
    idle, ids = {}, [x.name for x in RUNS.glob("*")]
    working = owner_rule(busy=True)
    taken = lambda o: o["at"] if isinstance(o.get("at"), (int, float)) else ts(o.get("at")) or 0  # epoch or now()
    busy = {run_of(o.get("owner"), ids) for _, o in lock_owners()
            if isinstance(o, dict) and working(o.get("owner")) and time.time() - taken(o) < IDLE_RUN_SECS}
    for r in active_runs():
        if not r.get("id"):
            continue
        secs = idle_secs(RUNS / r["id"], r, busy)
        if secs is not None and secs > IDLE_RUN_SECS:
            idle[r["id"]] = secs
    for rid, secs in idle.items():
        if not a.run or rid == a.run:
            lines.append(f"IDLE run {rid}: active, no active worker for {secs / 3600:.0f}h — resume it (orch spawn) "
                         f"or end it (orch end-run --run {rid} --status aborted)")
    if not any_active_run() and not a.dry_run and caffeinate_release():
        lines.append("caffeinate released (no active runs)")
    elif idle and len(idle) == len(active_runs()) and not a.dry_run and caffeinate_release():
        lines.append("caffeinate released (every active run idle >12h; spawn takes it again)")
    if not any_active_run() and not a.keep_sim:
        msg = sims_down(dry=a.dry_run)
        if msg:
            lines.append(msg + " (no active runs)")
    verb = "would free" if a.dry_run else "freed"
    print("\n".join(lines) if lines else "nothing to clean")
    if total:
        print(f"{verb} ~{total:.0f}MB")


def cmd_end_run(a):
    p = RUNS / a.run / "run.json"
    r = read_json(p) or sys.exit(f"orch: no run {a.run}")
    if a.status == "done" and (RUNS / a.run / "criteria.json").exists():
        # every criterion must have passed on a commit that is now part of origin/<default>
        git(r["repo"], "fetch", "--quiet", "origin")
        items = read_json(RUNS / a.run / "criteria.json")
        bad = [c["id"] for c in items if c["status"] != "pass" or not c.get("sha") or subprocess.run(
            ["git", "merge-base", "--is-ancestor", c["sha"], f"origin/{r['default_branch']}"],
            cwd=r["repo"]).returncode != 0]
        if bad:
            sys.exit(f"orch: refusing to end run — not passing on shipped code: {', '.join(bad)} (orch criteria-check)")
    # tear everything down: every worker (whatever its state), the integration worktree, its processes
    total, names = 0.0, owner_names()
    for w, wk in workers_of(RUNS / a.run, status=None):
        did, mb = cleanup_worker(r, wk, full=True, names=names)
        total += mb
        if wk.get("status") in ("active", "dead"):  # dead too, so a retry cleans it in full
            wk["status"] = a.status
        done = cleanup_complete(r, wk, did)
        if done:
            wk["cleaned"] = now()
        write_json(w, wk)
        if not done:
            print(f"NOT finished {wk['name']}: {', '.join(did) or 'nothing'} tried, pane or worktree left — "
                  f"retry with orch reap --run {a.run}")
        elif did:
            print(f"cleaned {wk['name']}: {', '.join(did)}")
    integ = {"name": f"{a.run}-integrate", "ports": None}
    did, mb = cleanup_worker(r, integ, full=True, names=names)
    total += mb
    if not cleanup_complete(r, integ, did):  # like a worker: say so, and reap --run retries it
        print(f"NOT finished {integ['name']}: {', '.join(did) or 'nothing'} tried, worktree left — "
              f"retry with orch reap --run {a.run}")
    elif did:
        print(f"cleaned {integ['name']}: {', '.join(did)}")
    git(r["repo"], "branch", "-D", f"{a.run}-integrate", check=False)
    git(r["repo"], "worktree", "prune", check=False)
    if r.get("target", "").startswith("orch/"):
        git(r["repo"], "push", "--quiet", "origin", f":refs/heads/{r['target']}", check=False)
    if r.get("dash_ws") and have_cmux():
        target, skip, _ = close_target(r["dash_ws"], r.get("dash_id"), f"{a.run} dashboard", cmux_nodes())
        if target:
            cmux("workspace", "close", "--workspace", target, "--force", timeout=30)
        elif skip:
            print(f"dashboard {skip}")
    g = r.get("group")
    shared = g and any(x.get("group") == g or (r.get("coordinator_workspace") and x.get("coordinator_workspace")
                                                 == r["coordinator_workspace"]) for x in active_runs(except_run=a.run))
    if g and not shared and have_cmux():  # only workers + dashboard lived in it; members (the coordinator) stay
        res = cmux("workspace-group", "ungroup", g)
        print(f"group {g} dissolved" if res.returncode == 0 else f"orch: could not dissolve group {g}: "
              f"{(res.stderr or res.stdout).strip()}")
    (HOME / "state" / f"watch-{a.run}.json").unlink(missing_ok=True)
    ids = [x.name for x in RUNS.glob("*")]
    for x, o in lock_owners():  # everything still held under this run's names: ports, resources, merge, files
        if run_of((o or {}).get("owner"), ids) == a.run:
            if x.parent == LOCKS / "ports" and x.name.isdigit():
                remember_block(int(x.name), o.get("owner"))
            steal_lock(x, o)
    r.update(status=a.status, ended=now())
    write_json(p, r)
    if not any_active_run():
        caffeinate_release()
    if not a.keep_sim and not any_active_run():
        msg = sims_down()
        if msg:
            print(msg + " (no other active runs)")
    print(f"{a.run} {a.status}" + (f" — freed ~{total:.0f}MB" if total else ""))


def cmd_status(a):
    for run_dir in sorted(RUNS.glob("*")):
        r = read_json(run_dir / "run.json") or {}
        if (a.run and r.get("id") != a.run) or (not a.all and r.get("status") != "active"):
            continue
        print(f"{r.get('id')}  [{r.get('status')}]  {r.get('repo')}  target={r.get('target')}  coord={r.get('coordinator')}")
        for _, wk in workers_of(run_dir, status=None):
            print(f"   {wk.get('slice'):20} {wk.get('status'):8} {wk.get('workspace')}  {wk.get('sha', '')[:10]}")


def cmd_broadcast(a):
    """Coordinator → its own run's active workers (optionally only those pushing to --branch)."""
    d = RUNS / a.run
    if not (d / "run.json").exists():
        sys.exit(f"orch: no run {a.run}")
    need_cmux()
    sent, failed = [], []
    for _, wk in workers_of(d):
        if a.branch and wk.get("target") != a.branch:
            continue
        (sent if cmux_message(wk.get("surface_id") or wk.get("workspace"), a.text, "coordinator") else failed).append(wk["name"])
    print(f"sent to: {', '.join(sent) or '-'}" + (f"; UNDELIVERED: {', '.join(failed)}" if failed else ""))


def cmd_report(a):
    """Compact status table for the 30-minute heartbeat updates (deterministic, cheap)."""
    d = RUNS / a.run
    r = read_json(d / "run.json") or sys.exit(f"orch: no run {a.run}")
    live = cmux_live_workspaces()
    crit = read_json(d / "criteria.json", [])
    npass = sum(c["status"] == "pass" for c in crit)
    print(f"{r['id']} [{r['status']}] → {r['target']}  criteria {npass}/{len(crit)} passing  ({time.strftime('%H:%M')})")
    slices = sorted(p.stem for p in (d / "slices").glob("*.md") if not p.name.endswith(".progress.md"))
    workers = {wk["slice"]: wk for _, wk in workers_of(d, status=None)}
    for sl in slices:
        wk = workers.get(sl)
        prog = d / "slices" / f"{sl}.progress.md"
        last, age = "", None
        if prog.exists():
            lines = [x for x in prog.read_text().splitlines() if x.strip()]
            last, age = (lines[-1] if lines else ""), int((time.time() - prog.stat().st_mtime) // 60)
        if not wk:
            state = "queued"
        elif wk["status"] == "active" and not worker_live(wk, live):
            state = "DEAD"
        else:
            state = wk["status"]
        stale = " STALLED" if state == "active" and age is not None and age >= a.stall else ""
        print(f"  {sl:18} {state:7}{stale:8} {'' if age is None else f'{age}m ago':8} {last[:90]}")


# ---------------------------------------------------------------- dashboard (live view for the user)
def add_need(d, text):
    """Add an item to NEEDS YOU (deduplicated by text)."""
    needs = read_json(d / "waiting.json", [])
    if not any(n["text"] == text for n in needs):
        needs.append({"text": text, "since": time.strftime("%H:%M")})
        write_json(d / "waiting.json", needs)
    return needs


def cmd_note(a):
    """Coordinator-maintained dashboard inputs: slice plan, items needing the user, next tick, finish progress."""
    d = RUNS / a.run
    if not (d / "run.json").exists():
        sys.exit(f"orch: no run {a.run}")
    if (read_json(d / "run.json") or {}).get("status") == "active":
        caffeinate_hold()  # the coordinator is back on this run (reap may have released it while idle)
    if a.plan:
        write_json(d / "plan.json", read_json(Path(a.plan)) or sys.exit(f"orch: bad plan file {a.plan}"))
    needs = add_need(d, a.wait) if a.wait else read_json(d / "waiting.json", [])
    if a.done:
        needs = [] if a.done == "all" else [w for i, w in enumerate(needs, 1) if str(i) != a.done]
        write_json(d / "waiting.json", needs)
    if a.next_tick:
        hh, mm = map(int, a.next_tick.split(":"))
        t = time.localtime()
        nt = time.mktime((t.tm_year, t.tm_mon, t.tm_mday, hh, mm, 0, 0, 0, -1))
        write_json(d / "ticks.json", {**read_json(d / "ticks.json", {}), "next": nt})
    if a.finish is not None:
        write_json(d / "finish.json", {"step": a.finish, "at": time.strftime("%H:%M")})
    for i, w in enumerate(needs, 1):
        print(f"  {i}. [{w['since']}] {w['text']}")


WORKER_STEPS = [(1, "setup + sync"), (2, "implement (tests red → green)"), (3, "gates"), (4, "review + verify"),
                (5, "fix loop (if review/verify fails)"), (6, "rebase + push to run branch")]
FINISH_STEPS = ["integration worktree + rebase on main", "all checks + secrets scan",
                "final review + adversarial + verify (all criteria)", "push to main", "end run + clean up"]


def _dash_frame(run):
    d = RUNS / run
    r = read_json(d / "run.json") or {}
    B, DIM, G, Y, R_, C, X = "\033[1m", "\033[2m", "\033[32m", "\033[33m", "\033[31m", "\033[36m", "\033[0m"
    W = min(shutil.get_terminal_size((100, 40)).columns, 140)
    crit = read_json(d / "criteria.json", [])
    npass = sum(c.get("status") == "pass" for c in crit)
    bar = "█" * round(10 * npass / len(crit)) + "░" * (10 - round(10 * npass / len(crit))) if crit else ""
    nxt = read_json(d / "ticks.json", {}).get("next")  # set once from CronCreate's "Next run"; fixed 30-min heartbeat
    if nxt and nxt < time.time() - 60:
        nxt += ((time.time() - nxt) // 1800 + 1) * 1800
    secs = max(0, int(nxt - time.time())) if nxt else 0
    tick = f"{time.strftime('%H:%M', time.localtime(nxt))} ({secs // 60}m{secs % 60:02d}s)" if nxt else "—"
    status = r.get("status", "?")
    if status != "active":
        tick = "—"
    tag = lambda who: f"{DIM}{who:>6}{X}"

    live = cmux_live_workspaces()
    workers = {wk["slice"]: wk for _, wk in workers_of(d, status=None) if wk["slice"] != "integrate"}
    plan = read_json(d / "plan.json", [])
    meta = {x["id"]: x for x in plan}
    briefed = sorted(p.stem for p in (d / "slices").glob("*.md") if not p.name.endswith(".progress.md"))
    order = list(dict.fromkeys([x["id"] for x in plan] + briefed + list(workers)))
    merged = {sl for sl, wk in workers.items() if wk["status"] in ("done", "merged")}
    fin = read_json(d / "finish.json", {}).get("step", 0)  # 0 = not started, 1..5 = current step, 6 = finished
    if status != "active":
        fin = 6

    needs = read_json(d / "waiting.json", [])
    waiting, working, pending, done = [], [], [], []
    for sl in order:
        m, wk = meta.get(sl, {}), workers.get(sl)
        name = f"{sl} {m.get('title', '')}".strip()
        prog = d / "slices" / f"{sl}.progress.md"
        lines = [x for x in prog.read_text().splitlines() if x.strip() and not x.startswith("#")] if prog.exists() else []
        age = int((time.time() - prog.stat().st_mtime) // 60) if prog.exists() else None
        if sl in merged:
            sha = next((mm.group(1) for ln in reversed(lines) for mm in [re.search(r"\b([0-9a-f]{7,12})\b", ln)] if mm), "")
            when = (lines[-1][:5] if lines else "")
            done.append(f"  {G}✓{X} {name:24} {sha[:7]:8} {DIM}{when}{X}")
            continue
        step = max([int(mm.group(1)) for ln in lines for mm in [re.search(r"\bstep (\d+)", ln)] if mm] or [0])
        active = bool(wk and wk["status"] == "active")
        if active:
            dead = not worker_live(wk, live)
            stalled = age is not None and age >= 15
            dot = f"{R_}✗ DEAD{X}" if dead else f"{Y}● STALLED{X}" if stalled else f"{G}●{X}"
            label = dict(WORKER_STEPS).get(step, "starting")
            working.append(f"  {dot} {name:22} step {step or '—'} {label} {DIM}· {'' if age is None else f'{age}m ago'}{X}"
                           .ljust(W - 8) + tag("worker"))
            for ln in lines[-2:]:
                working.append(f"      {DIM}{ln[:W - 8]}{X}")
            if step == 4:
                waiting.append(f"  {name:22} review + verify  {DIM}← its reviewer + verifier{X}".ljust(W - 8) + tag("worker"))
            for n, lab in WORKER_STEPS:
                if n >= max(step, 1):
                    pending.append((f"{sl}  {lab}", "worker", n == step))
        else:
            deps = [x for x in m.get("depends", []) if x not in merged]
            if deps:
                waiting.append(f"  {name:22} {DIM}← {', '.join(deps)} merged{X}".ljust(W - 8) + tag("worker"))
            else:
                waiting.append(f"  {name:22} {DIM}← dispatch (≤3 workers at once){X}".ljust(W - 8) + tag("coord"))
            goal = f": {m['goal']}" if m.get("goal") else ""
            pending.append((f"{sl}  {m.get('title', '')}{goal} — all 6 steps", "worker", False))
    slices_left = [sl for sl in order if sl not in merged]
    if fin < 6:
        if fin == 0:
            waiting.append(f"  {'run finish':22} {DIM}← {', '.join(slices_left) or 'coordinator'}{X}".ljust(W - 8) + tag("coord"))
        else:
            working.append(f"  {G}●{X} {'run finish':22} {FINISH_STEPS[fin - 1]}".ljust(W - 8) + tag("coord"))
            if fin == 3:
                waiting.append(f"  {'run finish':22} {DIM}← final reviewers + verifier{X}".ljust(W - 8) + tag("coord"))
        for i, lab in enumerate(FINISH_STEPS, 1):
            if i >= max(fin, 1):
                pending.append((f"run {lab}", "coord", i == fin))
    for i, lab in enumerate(FINISH_STEPS, 1):
        if i < fin:
            done.append(f"  {G}✓{X} run {lab}")

    out = [f"{B}{Path(r.get('repo', '?')).name}{X} · {r.get('title', run)}  {DIM}{run} [{status}]{X}  "
           f"{time.strftime('%H:%M:%S')}   next tick {C}{tick}{X}",
           f"Criteria {npass}/{len(crit)} {G}{bar}{X}", ""]
    out.append(f"{B}{Y}NEEDS YOU ({len(needs)}){X}" if needs else f"{B}NEEDS YOU{X} {DIM}nothing{X}")
    out += [f"  {Y}!{X} {i}. {n['text'][:W - 20]} {DIM}since {n['since']}{X}" for i, n in enumerate(needs, 1)]
    out += ["", f"{B}WAITING ({len(waiting)}){X}"] + (waiting or [f"  {DIM}nothing blocked{X}"])
    out += ["", f"{B}WORKING ({sum(not w.startswith('      ') for w in working)}){X}"] + (working or [f"  {DIM}idle{X}"])
    out += ["", f"{B}PENDING ({len(pending)}){X}"]
    for i, (txt, who, now_) in enumerate(pending, 1):
        line = f"  {i:2}. {txt[:W - 24]}"
        out.append((f"{Y}{line}{X}" if now_ else line).ljust(W - 8 + (len(Y) + len(X) if now_ else 0)) + tag(who) +
                   (f" {Y}● now{X}" if now_ else ""))
    if not pending:
        out.append(f"  {DIM}nothing left{X}")
    out += ["", f"{B}DONE ({len(done)}){X}"] + (done or [f"  {DIM}nothing yet{X}"])
    return "\n".join(out)


def cmd_dash(a):
    """Live terminal dashboard: redraws every --every seconds (Ctrl-C to quit)."""
    if a.open:
        need_cmux()
        print(open_dash(a.run) or "orch: dashboard already open")
        return
    if a.once:
        print(_dash_frame(a.run))
        return
    try:
        while True:
            sys.stdout.write("\033[H\033[2J" + _dash_frame(a.run) + "\n")
            sys.stdout.flush()
            time.sleep(a.every)
    except KeyboardInterrupt:
        pass


def open_dash(run):
    """Open the dashboard as its own workspace in the coordinator's group (once per run)."""
    d = RUNS / run
    r = read_json(d / "run.json") or sys.exit(f"orch: no run {run}")
    nodes = cmux_nodes()
    live = cmux_live_workspaces(nodes)
    if r.get("dash_id"):  # by its uuid (or its ref, on a cmux that lists none); unknown: never open a second one
        there = worker_live({"surface_id": r["dash_id"], "workspace": r["dash_ws"]}, live)
    elif r.get("dash_ws"):  # recorded before ids: still ours only while that ref has the dashboard's title
        there = nodes is None or (nodes.get(r["dash_ws"]) or (None, None))[1] == f"{run} dashboard"
    else:
        there = False
    if there:
        return None
    ws = r.get("coordinator_workspace")
    group = cmux_group_for(ws, run, f"{Path(r['repo']).name} · {r.get('title', run)}") if ws else None
    if group and r.get("group") != group:
        r["group"] = group
    args = [CMUX, "new-workspace", "--name", f"{run} dashboard", "--cwd", r["repo"],
            "--command", f"{shlex.quote(str(Path(__file__).resolve()))} dash --run {shlex.quote(run)}", "--focus", "false"]
    if group:
        args += ["--group", group, "--group-placement", "afterCurrent", "--group-reference", ws]
    out = cmux(*args[1:], timeout=30).stdout
    m = re.search(r"workspace:\d+", out)
    if not m:
        if group:
            write_json(d / "run.json", r)
        return f"orch: could not open dashboard: {out.strip()}"
    r["dash_ws"] = m.group(0)
    r["dash_id"] = ((cmux_nodes() or {}).get(m.group(0)) or (None,))[0]  # end-run closes it by this stable id
    write_json(d / "run.json", r)
    return f"dashboard → {m.group(0)}" + (f" in {group}" if group else "")


# ---------------------------------------------------------------- worker commands
def cmd_register(a):
    wt = a.worktree
    r = read_json(RUNS / a.run / "run.json") or sys.exit(f"orch: no run {a.run}")
    target = a.target or r["target"]
    git(wt, "fetch", "--quiet", "origin")
    if a.sync:
        # Point a FRESH worktree at origin/<target>. Refuses if it has edits or commits of its own.
        if git(wt, "status", "--porcelain", "--untracked-files=no"):  # untracked junk (e.g. firebase-debug.log) is harmless
            sys.exit("orch: --sync refused: worktree has uncommitted changes")
        own = git(wt, "rev-list", "HEAD", "--not", f"origin/{target}", f"origin/{r['default_branch']}")
        if own:
            sys.exit(f"orch: --sync refused: worktree has {len(own.split())} commit(s) of its own (resume instead)")
        git(wt, "reset", "--quiet", "--hard", f"origin/{target}")
    write_json(git_dir(wt) / "orchestra-owner.json", {
        "owner": f"{a.run}-{a.slice}", "run": a.run, "slice": a.slice, "target": target,
        "risky": a.risky, "workspace": cmux_workspace(), "at": now()})
    print(f"registered {a.run}-{a.slice} → pushes to {target}{' (risky: adversarial review required)' if a.risky else ''}")


# same file listing as push-guard's touched(): unquoted paths, merge-carried changes included
LOG_FILES = ("-c", "core.quotepath=off", "log", "--diff-merges=combined", "--no-renames", "--name-only", "--format=")


def tier_shipped(repo, t):
    """Same rule as push-guard's shipped(): ancestor of the target, or a target commit holds the change's content for
    every file it touched (squash-merged PR)."""
    ok = lambda *args: subprocess.run(["git", "--literal-pathspecs", *args], cwd=repo, capture_output=True).returncode == 0
    if ok("merge-base", "--is-ancestor", t["sha"], t["target"]):
        return True
    files = t.get("files", [])
    cs = git(repo, "--literal-pathspecs", "rev-list", "--max-count=500", t["target"], "--not", t["sha"], "--", *files,
             check=False).splitlines() if files else []
    return any(ok("diff", "--quiet", t["sha"], c, "--", *files) for c in cs)


def tier_bound_ref(repo, t):
    """First of HEAD / local branches push-guard would still bind to the record: it contains the change, or its
    unpushed commits touch the change's files (an amended/rebased/cherry-picked copy). None when nothing is bound."""
    files = set(t.get("files", []))
    for ref in ["HEAD", *git(repo, "for-each-ref", "--format=%(refname)", "refs/heads").splitlines()]:
        if subprocess.run(["git", "merge-base", "--is-ancestor", t["sha"], ref], cwd=repo).returncode == 0:
            return ref
        if files & set(git(repo, *LOG_FILES, ref, "--not", "--remotes").splitlines()):
            return ref
    return None


def cmd_tier(a):
    """Record the task tier for HEAD (one record per repo). Tier S ships from a main checkout: push-guard then wants
    gates + a reviewer PASS on the pushed commit, and binds the tier to the files the S change touches. M/L recorded
    on a committed change makes push-guard deny shipping it from a main checkout (it goes through a worker)."""
    p = Path(git(a.repo, "rev-parse", "--path-format=absolute", "--git-common-dir")) / "orchestra-tier.json"
    if a.clear == bool(a.set):
        sys.exit("orch: tier needs exactly one of --set S|M|L or --clear")
    if a.clear:
        old = read_json(p, {})
        held = old and not tier_shipped(a.repo, old) and tier_bound_ref(a.repo, old)
        if held:
            sys.exit(f"orch: {held} still carries the tier-{old['tier']} change {old['sha'][:10]} or a copy of it "
                     f"(unpushed commits touching {', '.join(old.get('files', [])[:3])}) — ship it, or reset/delete "
                     f"that branch, then orch tier --clear")
        p.unlink(missing_ok=True)
        return print("tier record cleared")
    if a.set == "S" and git(a.repo, "branch", "-r", "--contains", "HEAD"):
        sys.exit("orch: HEAD is already on a remote — commit the S change first, then orch tier --set S")
    sha, target = head(a.repo), f"origin/{default_branch(a.repo)}"
    files = set(git(a.repo, *LOG_FILES, "HEAD", "--not", target).splitlines())  # paths may hold spaces
    old = read_json(p, {})
    anc = lambda x, y: subprocess.run(["git", "merge-base", "--is-ancestor", x, y], cwd=a.repo).returncode == 0
    if (old.get("tier") == "S" and not a.replace and not tier_shipped(a.repo, old) and not anc(old["sha"], sha)
            and not files & set(old.get("files", []))):
        sys.exit(f"orch: tier S for {old['sha'][:10]} ({', '.join(old.get('files', [])[:3])}) hasn't shipped and this "
                 f"change is unrelated — ship it first, or pass --replace to drop it")
    write_json(p, {"tier": a.set, "sha": sha, "target": target, "files": sorted(files), "at": now()})
    print(f"tier {a.set} recorded for {sha[:10]} ({len(files)} file(s))")


ERROR_LINE = re.compile(r"\berror\b|\bERR!|\bfail(ed|ure|ing)?\b|exception|traceback|panic:|✗|✘", re.I)
NOT_ERROR = re.compile(r"\b0 (errors?|failed|failures?)\b", re.I)


def first_error(out):
    """The first error-looking line of a gate's output, else its last 5 lines."""
    lines = out.strip().splitlines()
    hit = next((x for x in lines if ERROR_LINE.search(x) and not NOT_ERROR.search(x)), None)
    return [hit] if hit else lines[-5:]


HYGIENE_FILES = ((".env", lambda f: Path(f).name.startswith(".env") and Path(f).name != ".env.example"),
                 ("node_modules", lambda f: "node_modules" in Path(f).parts),
                 (".pem", lambda f: f.endswith(".pem")),
                 (".DS_Store", lambda f: Path(f).name == ".DS_Store"))
HYGIENE_LINES = (("debugger", re.compile(r"\bdebugger\b")), ("console.log", re.compile(r"\bconsole\.log\s*\(")))
JS_FILES = ("*.js", "*.jsx", "*.mjs", "*.cjs", "*.ts", "*.tsx", "*.mts", "*.cts", "*.vue", "*.svelte", "*.html")


def hygiene(wt, target):
    """Named reasons the change (commits + staged, vs origin/<target>) adds what never belongs in a commit.
    A repo CLAUDE.md line `orch-allow: console.log, .DS_Store` opts out of those names."""
    base = git(wt, "merge-base", f"origin/{target}", "HEAD", check=False)
    if not base:
        return []
    md = git(wt, "show", "HEAD:CLAUDE.md", check=False)  # committed text only, so the reviewer saw the opt-out
    allow = set(re.findall(r"[^\s,]+", " ".join(re.findall(r"^\s*orch-allow:(.*)$", md, re.M))))
    added = git(wt, "-c", "core.quotepath=off", "diff", "--cached", "--name-only", "--diff-filter=ACR", base).splitlines()
    bad = []
    for name, hit in HYGIENE_FILES:
        files = [f for f in added if hit(f)]
        if files and name not in allow:
            bad.append(f"adds {name}: {', '.join(files[:3])}")
    diff = git(wt, "diff", "--cached", "-U0", base, "--", *JS_FILES)
    lines = [x[1:] for x in diff.splitlines() if x.startswith("+") and not x.startswith("+++")]
    for name, rx in HYGIENE_LINES:
        n = sum(bool(rx.search(x)) for x in lines)
        if n and name not in allow:
            bad.append(f"adds {n} {name} line(s) in js/ts/vue/svelte/html")
    return bad


def cmd_gates(a):
    wt = a.worktree
    o = owner_info(wt) or {}  # unregistered = tier S in a main checkout; evidence still lands in its git dir
    target = o.get("target") or default_branch(wt)
    sha, results = head(wt), []
    logs = git_dir(wt) / "orchestra-artifacts" / "gates"
    logs.mkdir(parents=True, exist_ok=True)
    for cmd in a.cmd:
        t = time.time()
        p = subprocess.run(["bash", "-lc", cmd], cwd=wt, capture_output=True, text=True)
        log = logs / f"{sha[:10]}-{hashlib.sha1(cmd.encode()).hexdigest()[:8]}.log"
        log.write_text(p.stdout + p.stderr)
        results.append({"cmd": cmd, "exit": p.returncode, "secs": round(time.time() - t), "log": str(log)})
        print(f"{'ok  ' if p.returncode == 0 else 'FAIL'} {cmd}  ({results[-1]['secs']}s)  {log}")
        for line in first_error(p.stdout + p.stderr) if p.returncode else []:
            print(f"      {line[:160]}")
    bad = hygiene(wt, target)
    if bad:
        results.append({"cmd": "hygiene", "exit": 1, "secs": 0, "log": "", "reasons": bad})
        print(f"FAIL hygiene: {'; '.join(bad)}  (opt out: repo CLAUDE.md `orch-allow: <name>`)")
    write_json(git_dir(wt) / "orchestra-gates-run.json", {"sha": sha, "at": now(), "results": results})
    if any(x["exit"] for x in results):
        sys.exit(1)


def cmd_verdict(a):
    wt, o = a.worktree, owner_info(a.worktree) or {}  # unregistered = tier S lite review in a main checkout
    if git(wt, "status", "--porcelain", "--untracked-files=no"):
        sys.exit("orch: uncommitted changes — a verdict must be about a commit")
    p = git_dir(wt) / "orchestra-verdicts.json"
    v = read_json(p, [])
    v.append({"role": a.role, "verdict": a.verdict, "sha": head(wt),
              "patch_id": patch_id(wt, o.get("target") or default_branch(wt)),
              "mode": a.mode, "summary": a.summary, "at": now()})
    write_json(p, v)
    print(f"{a.role} {a.verdict} recorded for {head(wt)[:10]}")


def cmd_criterion(a):
    p = RUNS / a.run / "criteria.json"
    items = read_json(p) or sys.exit("orch: no criteria.json for this run")
    for c in items:
        if c["id"] == a.id:
            c.update(status=a.status, sha=a.sha, evidence=a.evidence, at=now())
            write_json(p, items)
            print(f"{a.id} {a.status} @ {a.sha[:10]}")
            return
    sys.exit(f"orch: no criterion {a.id}")


def cmd_gates_ok(a):
    wt, o = a.worktree, owner_info(a.worktree) or sys.exit("orch: worktree not registered")
    if git(wt, "status", "--porcelain", "--untracked-files=no"):
        sys.exit("orch: uncommitted changes — commit first so the recorded HEAD is what gets pushed")
    sha, pid, problems = head(wt), patch_id(wt, o["target"]), []
    gr = read_json(git_dir(wt) / "orchestra-gates-run.json") or {}
    if gr.get("sha") != sha:
        problems.append("gates were not run on this HEAD (orch gates --cmd ...)")
    elif any(x["exit"] for x in gr["results"]) and not a.accept_failures:
        problems.append("a gate failed; fix it, or pass --accept-failures '<why it matches the baseline>'")
    verdicts = read_json(git_dir(wt) / "orchestra-verdicts.json", [])

    def latest(role):
        vs = [v for v in verdicts if v["role"] == role]
        return vs[-1] if vs else None
    roles = PASS_ROLES + (("adversarial",) if o.get("risky") else ())
    for role in roles:
        v = latest(role)
        if not v or v["verdict"] != "PASS":
            problems.append(f"no PASS from {role} (latest: {v['verdict'] if v else 'none'})")
        elif v["sha"] != sha and not (role != "verifier" and pid and v.get("patch_id") == pid):
            # reviewer verdicts survive a clean rebase (identical patch); the verifier must re-run on HEAD
            problems.append(f"{role} PASS is for {v['sha'][:10]}, not HEAD {sha[:10]}"
                            + ("" if role == "verifier" else " and the patch changed during rebase"))
    if problems:
        sys.exit("orch: gates-ok refused:\n  - " + "\n  - ".join(problems))
    write_json(git_dir(wt) / "orchestra-gates.json", {
        "sha": sha, "owner": o["owner"], "target": o["target"], "at": now(),
        "accepted_failures": a.accept_failures or "", "evidence": a.evidence})
    print(f"gates-ok recorded for {sha[:10]} → may push to {o['target']}")


def merge_dir(path):
    return LOCKS / slug_of(path) / "merge"


@contextlib.contextmanager
def lock_guard():
    """Exclusive flock serialising every take / steal / release of an orch lock dir (all orch processes, short hold)."""
    LOCKS.mkdir(parents=True, exist_ok=True)
    with open(LOCKS / ".guard", "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def take_lock(d, info):
    """Create lock dir `d` with owner.json already inside: built under a temp name, then renamed into place, so no
    reader ever sees the lock without its owner. False if `d` exists (held, or an ownerless dir in its grace period).
    The exists-check and rename run under lock_guard: a directory rename would silently replace an EMPTY `d`."""
    d.parent.mkdir(parents=True, exist_ok=True)
    with lock_guard():
        if d.exists():
            return False
        tmp = None
        try:
            (LOCKS / ".tmp").mkdir(exist_ok=True)  # same filesystem as every lock dir, never matched by their globs
            tmp = Path(tempfile.mkdtemp(prefix=f"{d.name}.", suffix=".tmp", dir=LOCKS / ".tmp"))
            (tmp / "owner.json").write_text(json.dumps(info, indent=2))
            os.rename(tmp, d)
            return True
        except OSError as e:
            if d.exists():
                return False
            sys.exit(f"orch: could not create lock {d}: {e}")
        finally:
            if tmp:
                shutil.rmtree(tmp, ignore_errors=True)  # gone already when the rename won


def steal_lock(d, seen):
    """Remove lock `d` only if it still holds exactly the owner.json that was judged (`seen`): under lock_guard nobody
    can take or release it in between, so a lock retaken meanwhile is left alone. True if it was removed."""
    with lock_guard():
        if d.is_dir() and read_json(d / "owner.json") == seen:
            shutil.rmtree(d, ignore_errors=True)
            return True
    return False


def wait_lock(d, info, max_secs, wait, what, live_key):
    """Take lock `d` for info["owner"], waiting up to `wait` secs. A holder is stale when its pane is gone, its lock is
    older than max_secs, or the dir has had no owner.json for longer than LOCK_GRACE_SECS. Returns a message or None."""
    deadline = time.time() + wait
    while True:
        if take_lock(d, {**info, "at": time.time()}):
            return None
        o = read_json(d / "owner.json")
        if not isinstance(o, dict):
            if not d.exists():
                time.sleep(0.05)
                continue  # released between the two looks
            if dir_age(d) > LOCK_GRACE_SECS:
                print(f"taking stale {what} (no owner.json for {int(dir_age(d))}s)")
                steal_lock(d, o)
                continue
            holder = "a taker still writing it (no owner.json yet)"
        else:
            if o.get("owner") == info["owner"]:
                return "already held"
            live = cmux_live_workspaces()
            dead = live is not None and o.get(live_key) and o[live_key] not in live
            if dead or time.time() - (o.get("at") or 0) > max_secs:
                print(f"stealing stale {what} from {o.get('owner')} ({'holder gone' if dead else 'expired'})")
                steal_lock(d, o)
                continue
            holder = o.get("owner")
        if time.time() > deadline:
            sys.exit(f"BUSY {what} held by {holder}")
        time.sleep(5)


def drop_lock(d, owner, force, what):
    """Release lock `d` held by `owner`. A dir without owner.json may be mid-take: only --force removes it."""
    if not d.exists():
        return f"{what} not held"
    o = read_json(d / "owner.json")
    if not isinstance(o, dict):
        if not force:
            sys.exit(f"orch: {what} has no owner.json (being taken right now, or left by a crash) — "
                     f"re-run with --force if you are sure nobody holds it")
    elif o.get("owner") != owner:
        sys.exit(f"orch: {what} held by {o.get('owner')}, not {owner}")
    if not steal_lock(d, o):  # changed since we looked: released, or stolen as stale and retaken by someone else
        if not d.exists():
            return f"{what} not held"
        sys.exit(f"orch: {what} changed while releasing it (now {(read_json(d / 'owner.json') or {}).get('owner')}); "
                 f"nothing removed")
    return None


def cmd_merge_lock(a):
    info = {"owner": a.owner, "workspace": cmux_workspace()}  # cmux runs before the lock exists, never inside it
    msg = wait_lock(merge_dir(a.repo), info, MERGE_LOCK_MAX_SECS, a.wait, "merge lock", "workspace")
    print(msg or f"merge lock held by {a.owner} — rebase, push, unlock; re-verify OUTSIDE the lock")


RESOURCES = ("sim", "chrome")  # shared, one-at-a-time things: the iOS Simulator, the user's real Chrome
RESOURCE_MAX_SECS = 30 * 60


def cmd_resource_lock(a):
    """Take a shared resource (sim / chrome); waits. Stale if the holder's pane is gone or >30 min."""
    info = {"owner": a.owner, "surface": cmux_workspace()}
    msg = wait_lock(LOCKS / "resources" / a.name, info, RESOURCE_MAX_SECS, a.wait, f"{a.name} lock", "surface")
    print(msg or f"{a.name} held by {a.owner} — release with: orch resource-unlock --name {a.name} --owner {a.owner}")


def cmd_resource_unlock(a):
    print(drop_lock(LOCKS / "resources" / a.name, a.owner, a.force, f"{a.name} lock") or f"{a.name} released")


def cmd_merge_unlock(a):
    print(drop_lock(merge_dir(a.repo), a.owner, a.force, "merge lock") or "merge lock released")


GC_KEEP = ("spec.md", "HANDOFF.md", "criteria.json", "plan.json", "run.json")


def du(p):
    """Bytes under p, never following symlinks."""
    if p.is_symlink() or not p.is_dir():
        return p.lstat().st_size
    total = 0
    for root, dirs, files in os.walk(p):
        for f in dirs + files:
            try:
                total += os.lstat(os.path.join(root, f)).st_size
            except FileNotFoundError:
                pass
    return total


def human(n):
    for unit in ("B", "K", "M"):
        if n < 1024:
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024
    return f"{n:.1f}G"


def cmd_gc(a):
    """Ended runs older than N days keep only spec/HANDOFF/criteria/plan/run.json (and lose their watch state)."""
    m = re.fullmatch(r"(\d+)d", a.ended_older_than) or sys.exit("orch: --ended-older-than takes <N>d, e.g. 14d")
    cutoff, total, lines = time.time() - int(m.group(1)) * 86400, 0, []
    for d in sorted(RUNS.glob("*")):
        if d.is_symlink() or not d.is_dir():
            continue
        r = read_json(d / "run.json")
        if not isinstance(r, dict) or r.get("status") in (None, "active"):
            continue  # never an active run (or one we can't read)
        ended = ts(r.get("ended"))
        if ended is None or ended > cutoff:
            continue
        drop = [x for x in sorted(d.iterdir()) if x.name not in GC_KEEP]
        watch = HOME / "state" / f"watch-{d.name}.json"
        if watch.exists():
            drop.append(watch)
        if not drop:
            continue
        size = sum(du(x) for x in drop)
        total += size
        lines.append(f"{d.name}  {human(size):>7}  {', '.join(x.name for x in drop)[:100]}")
        if not a.dry_run:
            for x in drop:
                if x.is_dir() and not x.is_symlink():
                    shutil.rmtree(x, ignore_errors=True)
                else:
                    x.unlink(missing_ok=True)
    if not lines:
        return print(f"nothing to gc (no run ended more than {a.ended_older_than} ago with extra files)")
    print("\n".join(lines))
    print(f"{'would free' if a.dry_run else 'freed'} {human(total)} from {len(lines)} ended run(s)")


def cmd_merged(a):
    o = owner_info(a.repo) or {}
    run_id, sl = a.run or o.get("run"), a.slice or o.get("slice")
    if not run_id or not sl:
        sys.exit("orch: merged needs --run/--slice (or a registered worktree)")
    slug, me = slug_of(a.repo), f"{run_id}-{sl}"
    branch = a.branch or o.get("target") or default_branch(a.repo)
    EVENTS.mkdir(parents=True, exist_ok=True)
    with open(EVENTS / f"{slug}.jsonl", "a") as f:
        f.write(json.dumps({"at": now(), "event": "merged", "by": me, "branch": branch, "sha": a.sha, "summary": a.summary}) + "\n")
    w = RUNS / run_id / "workers" / f"{sl}.json"
    wk = read_json(w)
    if wk:
        wk.update(status="merged", sha=a.sha, merged=now())
        write_json(w, wk)
    # Workers never message other workers: only coordinators are told; each relays to its own workers.
    told, failed = [], []
    for d, r in runs_for(slug):
        if r["id"] == run_id:
            continue  # own coordinator learns from the worker's MERGED report
        waiting = [wk["name"] for _, wk in workers_of(d) if wk["name"] != me and wk.get("target") == branch]
        text = (f"MOVED: {me} pushed {a.sha[:10]} to origin/{branch} ({a.summary}). "
                + (f"Your workers pushing to {branch}: {', '.join(waiting)} — relay: "
                   f"orch broadcast --run {r['id']} --branch {branch} \"REBASE: ...\"" if waiting
                   else f"None of your workers push to {branch}; note it for integration."))
        c = r.get("coordinator")
        if c:
            (told if cmux_message(c, text, me) else failed).append(f"coordinator of {r['id']}")
    print(f"recorded; told: {', '.join(told) or '-'}")
    if failed:
        print(f"UNDELIVERED (push-guard still blocks stale pushes): {', '.join(failed)}")


def main():
    p = argparse.ArgumentParser(prog="orch", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    s = p.add_subparsers(dest="command", required=True)
    c = s.add_parser("new-run"); c.add_argument("--repo", default="."); c.add_argument("--title", required=True); c.add_argument("--coordinator"); c.add_argument("--coordinator-workspace")
    c = s.add_parser("spawn"); c.add_argument("--run", required=True); c.add_argument("--slice", required=True); c.add_argument("--resume", action="store_true"); c.add_argument("--all-mcp", action="store_true", help="give the worker every MCP server"); c.add_argument("--native", action="store_true", help="slice needs the iOS Simulator (keeps cmux Computer Use)"); c.add_argument("--dry-run", action="store_true", help="print what it would run; call neither cmux nor claude")
    c = s.add_parser("close"); c.add_argument("--run", required=True); c.add_argument("--slice", required=True); c.add_argument("--status", default="done")
    c = s.add_parser("run-branch"); c.add_argument("--run", required=True)
    c = s.add_parser("baseline"); c.add_argument("--run", required=True); c.add_argument("--branch"); c.add_argument("--setup", help="e.g. 'npm ci'"); c.add_argument("--cmd", action="append", required=True)
    c = s.add_parser("add-worker"); c.add_argument("--run", required=True); c.add_argument("--slice", required=True); c.add_argument("--workspace", required=True)
    for n in ("lock", "unlock"):
        c = s.add_parser(n); c.add_argument("--repo", default="."); c.add_argument("--owner", required=True); c.add_argument("files", nargs="*")
    c = s.add_parser("locks"); c.add_argument("--repo", default=".")
    c = s.add_parser("criteria-init"); c.add_argument("--run", required=True); c.add_argument("--file", required=True)
    c = s.add_parser("criteria-add"); c.add_argument("--run", required=True); c.add_argument("--file", required=True)
    c = s.add_parser("ports"); c.add_argument("--run", required=True); c.add_argument("--name", required=True, help="e.g. integrate-verifier"); c.add_argument("--release", action="store_true")
    c = s.add_parser("criteria-check"); c.add_argument("--run", required=True); c.add_argument("--sha")
    c = s.add_parser("doctor"); c.add_argument("--run"); c.add_argument("--fix", action="store_true")
    c = s.add_parser("finish-worker"); c.add_argument("--run", required=True); c.add_argument("--slice", required=True); c.add_argument("--status", default="done")
    c = s.add_parser("end-run"); c.add_argument("--run", required=True); c.add_argument("--status", default="done", choices=["done", "aborted"]); c.add_argument("--keep-sim", action="store_true")
    c = s.add_parser("reap"); c.add_argument("--run"); c.add_argument("--dry-run", action="store_true"); c.add_argument("--keep-sim", action="store_true")
    c = s.add_parser("status"); c.add_argument("--run"); c.add_argument("--all", action="store_true")
    c = s.add_parser("broadcast"); c.add_argument("--run", required=True); c.add_argument("--branch"); c.add_argument("text")
    c = s.add_parser("dash"); c.add_argument("--run", required=True); c.add_argument("--every", type=float, default=2); c.add_argument("--once", action="store_true"); c.add_argument("--open", action="store_true", help="open it as a workspace in the run's group")
    c = s.add_parser("note"); c.add_argument("--run", required=True); c.add_argument("--plan", help="JSON [{id,title,wave,depends}]"); c.add_argument("--wait", help="add an item waiting on the user"); c.add_argument("--done", help="clear waiting item N, or 'all'"); c.add_argument("--next-tick", help="HH:MM of the next cron tick"); c.add_argument("--finish", type=int, choices=range(0, 7), help="run-finish step the coordinator is on (0 not started … 6 done)")
    c = s.add_parser("report"); c.add_argument("--run", required=True); c.add_argument("--stall", type=int, default=15, help="minutes without progress = STALLED")
    c = s.add_parser("register"); c.add_argument("--worktree", default="."); c.add_argument("--run", required=True); c.add_argument("--slice", required=True); c.add_argument("--target"); c.add_argument("--risky", action="store_true"); c.add_argument("--sync", action="store_true", help="fresh worktree: reset to origin/<target>")
    c = s.add_parser("gates"); c.add_argument("--worktree", default="."); c.add_argument("--cmd", action="append", required=True)
    c = s.add_parser("verdict"); c.add_argument("--worktree", default="."); c.add_argument("--role", required=True, choices=["reviewer", "adversarial", "verifier"]); c.add_argument("--verdict", required=True, choices=["PASS", "BLOCK", "FAIL", "BLOCKED"]); c.add_argument("--mode", default="full", choices=["full", "re-review", "specs-only", "lite"]); c.add_argument("--summary", default="")
    c = s.add_parser("tier"); c.add_argument("--repo", default="."); c.add_argument("--set", choices=["S", "M", "L"]); c.add_argument("--replace", action="store_true", help="drop an unshipped tier-S record for unrelated work"); c.add_argument("--clear", action="store_true", help="drop the tier record (abandoned change)")
    c = s.add_parser("criterion"); c.add_argument("--run", required=True); c.add_argument("--id", required=True); c.add_argument("--status", required=True, choices=["pass", "fail", "not-exercised"]); c.add_argument("--sha", required=True); c.add_argument("--evidence", default="")
    c = s.add_parser("gates-ok"); c.add_argument("--worktree", default="."); c.add_argument("--evidence", default=""); c.add_argument("--accept-failures")
    c = s.add_parser("merge-lock"); c.add_argument("--repo", default="."); c.add_argument("--owner", required=True); c.add_argument("--wait", type=int, default=1800)
    c = s.add_parser("resource-lock"); c.add_argument("--name", required=True, choices=RESOURCES); c.add_argument("--owner", required=True); c.add_argument("--wait", type=int, default=1800)
    c = s.add_parser("resource-unlock"); c.add_argument("--name", required=True, choices=RESOURCES); c.add_argument("--owner", required=True); c.add_argument("--force", action="store_true", help="also remove a lock dir with no owner.json")
    c = s.add_parser("merge-unlock"); c.add_argument("--repo", default="."); c.add_argument("--owner", required=True); c.add_argument("--force", action="store_true", help="also remove a lock dir with no owner.json")
    c = s.add_parser("gc"); c.add_argument("--ended-older-than", default="14d", help="<N>d (default 14d)"); c.add_argument("--dry-run", action="store_true", help="list what would go, with sizes")
    c = s.add_parser("merged"); c.add_argument("--repo", default="."); c.add_argument("--run"); c.add_argument("--slice"); c.add_argument("--branch"); c.add_argument("--sha", required=True); c.add_argument("--summary", default="")
    a = p.parse_args()
    if a.command == "lock" and not a.files:
        p.error("lock needs at least one file")
    globals()["cmd_" + a.command.replace("-", "_")](a)


if __name__ == "__main__":
    main()
