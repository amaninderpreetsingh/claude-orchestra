#!/usr/bin/env python3
"""orch-sim — one iOS Simulator clone per owner, so native verifications can run in parallel.

  acquire --owner O [--device "iPhone 16"]  print the UDID of clone `orch-O` (clone a shut-down
                                            base device of that type, else simctl create; boot it)
  release --owner O                         shut down + delete that clone
  reap [--dry-run]                          delete orch-* clones whose owner has no active worker
  list                                      orch-* clones: name udid state

No global lock: each owner has its own flock under ORCH_HOME/locks (freed by the kernel if the
holder is killed), so owners never wait on each other. Never touches devices whose name doesn't
start with `orch-`.
"""
import argparse, fcntl, json, os, re, subprocess, sys, time
from pathlib import Path

HOME = Path(os.environ.get("ORCH_HOME", Path.home() / ".claude" / "orchestra"))
RUNS, LOCKS = HOME / "runs", HOME / "locks"
PREFIX = "orch-"
LOCK_WAIT_SECS = 600          # a cold clone + boot can take a few minutes


def simctl(*args, check=True):
    r = subprocess.run(["xcrun", "simctl", *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        sys.exit(f"orch-sim: simctl {' '.join(args)} failed: {r.stderr.strip() or r.stdout.strip()}")
    return r


def devices(unavailable=False):
    d = json.loads(simctl("list", "devices", "-j").stdout)["devices"]
    return [x for runtime in d.values() for x in runtime if unavailable or x.get("isAvailable", True)]


def find(name):
    return next((x for x in devices(unavailable=True) if x["name"] == name), None)


def clones():
    return [x for x in devices(unavailable=True) if x["name"].startswith(PREFIX)]


class owner_lock:
    def __init__(self, owner):
        self.path = LOCKS / f"sim-{owner}.lock"

    def __enter__(self):
        LOCKS.mkdir(parents=True, exist_ok=True)
        self.fd = os.open(self.path, os.O_CREAT | os.O_RDWR)
        deadline = time.time() + LOCK_WAIT_SECS
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except BlockingIOError:
                if time.time() > deadline:
                    sys.exit(f"orch-sim: {self.path} held by a live process for >{LOCK_WAIT_SECS}s")
                time.sleep(0.2)

    def __exit__(self, *exc):
        os.close(self.fd)


def remove(dev):
    if dev["state"] != "Shutdown":
        simctl("shutdown", dev["udid"], check=False)
    simctl("delete", dev["udid"])


def owner_arg(s):
    if not re.fullmatch(r"[A-Za-z0-9._-]+", s) or s in (".", ".."):
        raise argparse.ArgumentTypeError("owner must match [A-Za-z0-9._-]+")
    return s


def cmd_acquire(a):
    name = PREFIX + a.owner
    with owner_lock(a.owner):
        dev = find(name)
        if dev:
            udid = dev["udid"]
        else:
            base = next((x for x in devices() if x["name"] == a.device and x["state"] == "Shutdown"), None)
            if base:
                udid = simctl("clone", base["udid"], name).stdout.strip()
            else:
                types = json.loads(simctl("list", "devicetypes", "-j").stdout)["devicetypes"]
                t = next((x for x in types if x["name"] == a.device), None)
                if not t:
                    sys.exit(f"orch-sim: no device type named {a.device!r} (see `xcrun simctl list devicetypes`)")
                udid = simctl("create", name, t["identifier"]).stdout.strip()
            dev = {"udid": udid, "state": "Shutdown"}
        if dev["state"] != "Booted":
            r = simctl("boot", udid, check=False)
            if r.returncode != 0 and "Booted" not in r.stderr:
                sys.exit(f"orch-sim: boot {udid} failed: {r.stderr.strip()}")
        simctl("bootstatus", udid)
    print(udid)


def cmd_release(a):
    with owner_lock(a.owner):
        dev = find(PREFIX + a.owner)
        if dev:
            remove(dev)
            print(f"released {dev['name']} {dev['udid']}")
        else:
            print(f"no clone for {a.owner}")


def active_owners():
    out = set()
    for f in RUNS.glob("*/workers/*.json"):
        try:
            wk = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if wk.get("status") == "active":
            out.add(wk.get("name"))
    return out


def cmd_reap(a):
    live = active_owners()
    for dev in clones():
        owner = dev["name"][len(PREFIX):]
        if any(owner == w or owner.startswith(w + "-") for w in live):   # <worker>-verify etc.
            continue
        if a.dry_run:
            print(f"would reap {dev['name']} {dev['udid']}")
            continue
        with owner_lock(owner):
            cur = find(dev["name"])              # a concurrent release may have beaten us
            if not cur:
                continue
            try:
                remove(cur)
            except SystemExit as e:              # one bad device must not abort the rest
                print(f"failed {cur['name']} {cur['udid']}: {e}", file=sys.stderr)
                continue
        print(f"reaped {dev['name']} {dev['udid']}")


def cmd_list(a):
    for dev in clones():
        print(dev["name"], dev["udid"], dev["state"])


def main():
    p = argparse.ArgumentParser(prog="orch-sim", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    s = p.add_subparsers(dest="cmd", required=True)
    c = s.add_parser("acquire"); c.add_argument("--owner", required=True, type=owner_arg); c.add_argument("--device", default="iPhone 16"); c.set_defaults(f=cmd_acquire)
    c = s.add_parser("release"); c.add_argument("--owner", required=True, type=owner_arg); c.set_defaults(f=cmd_release)
    c = s.add_parser("reap"); c.add_argument("--dry-run", action="store_true"); c.set_defaults(f=cmd_reap)
    c = s.add_parser("list"); c.set_defaults(f=cmd_list)
    a = p.parse_args()
    a.f(a)


if __name__ == "__main__":
    main()
